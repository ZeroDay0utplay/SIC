<%= turbo_stream.prepend "absences-list" do %>
  <tr id="absence-<%= @absence.id %>">
    <td><%= @absence.date_start %></td>
    <td>
      <span id="absence-name-<%= @absence.id %>" data-editable-target="name">
        <%= @absence.user.full_name %>
      </span>
    </td>
    <td>
      <span class='absence-type <%= I18n.transliterate(@absence.type_absence.downcase) %>'>
        <%= I18n.t("enums.type_absence.#{@absence.type_absence}") %>
      </span>
    </td>
    <td>Jours</td>
    <td class='description'><%= @absence.date_start.strftime("%d/%m/%Y") %></td>
    <td class='description'><%= @absence.date_end.strftime("%d/%m/%Y") %></td>
    <td class="align-content-center">
      <span class="absence-state <%= @absence.state %>">
        <%= I18n.t("enums.absence_state.#{@absence.state}") %>
      </span>
    </td>
    <td class="align-content-center">
      <%= link_to edit_absence_path(@absence), class:'icon-ideo icon-edit icon-blue icon-16',
                data: { controller:'absences', action:'click->absences#showModal', turbo_frame: 'modal', turbo: 'false'} do %>
        <%= inline_svg_tag ('icons/edit.svg') %>
      <% end %>
    </td>
  </tr>
<% end %>