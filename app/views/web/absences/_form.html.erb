<!-- app/views/absences/_form.html.erb -->
<%= turbo_frame_tag :remote_modal, target: :_top do %>
  <div class="modal fade modal-xl" id="absence" tabindex="-1" aria-labelledby="absenceModalLabel"
        aria-hidden="true" data-controller="bs-modal">
    <div class="modal-dialog">
      <div class="modal-content">
        <%= form_with(model: @absence, local: true) do |form| %>
          <div class="modal-header">
            <h5 class="modal-title"><%= @absence.persisted? ? "Modifier absence" : "Nouvelle absence" %></h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body" data-controller='absences'>
            <div class='container'>
              <div class='row'>

                <!-- -->
                <div class="col-sm-12 col-md-6 col-lg-5">

                  <div class="form-group mb-3">
                    <%= form.label :type_absence, "Type d'absence", class:'form-label' %>
                    <%= form.select :type_absence,
                        Absence.type_absences.keys.map { |key| [I18n.t("enums.type_absence.#{key}"), key] }, {},
                        class: 'form-control' %>
                  </div>

                  <div class='form-group mb-3 d-flex align-items-center justify-content-start'>
                    <div class="cover-date">
                      <%= form.label :date_start, 'Date de début', class:'form-label' %>
                      <%= form.date_field :date_start, class:'form-control', placeholder:"jj/mm/aaaa" %>
                    </div>

                    <div class="cover-date ms-3">
                      <%= form.label :date_end, 'Date de fin', class:'form-label' %>
                      <%= form.date_field :date_end, class:'form-control' %>
                    </div>
                  </div>

                  <div class="form-group">
                    <%= form.label :motif, 'Motif', class:'form-label' %>
                    <%= form.text_area :motif, rows: 5, class:'form-control' %>
                  </div>

                </div>

                <div class="col-sm-12 col-md-6 col-lg-4">

                  <div class="form-group">
                    <%= form.label :document, 'Pièce jointe', class:'form-label' %>
                    <%= form.file_field :document, class: 'form-control' %>
                  </div>

                </div>

                <div class="col-sm-12 col-md-12 col-lg-3">

                  <div class="form-group mb-3">
                    <%= form.label :state, "Réponse", class: 'form-label' %>

                    <% Absence.states.keys.each do |state| %>
                      <div>
                        <%= form.radio_button :state, state, id: "absence_state_#{state}" %>
                        <%= form.label "state_#{state}", I18n.t("enums.absence_state.#{state}") %>
                      </div>
                    <% end %>
                  </div>

                  <div class="form-group">
                    <%= form.label :user_id, 'Agent', class:'form-label' %>
                    <%= form.select :user_id,
                      options_for_select(User.where(role: :agent).map { |user| [user.full_name, user.id] }, form.object.user_id),
                      {}, { class: 'form-select' } %>
                  </div>

                </div>
                <!-- -->

              </div>
            </div>
          </div>
          <div class="modal-footer">
            <%= form.button type: 'reset', class: "btn btn-lg btn-outline-secondary" do %>
              Annuler
            <% end %>
            <%= form.button type: 'submit', class: "btn btn-lg mx-2 btn-save btn-blue-dark", data: { action: 'bs-modal#submitEnd'} do %>
              Enregistrer
              <%= inline_svg_tag('icons/save.svg') %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
