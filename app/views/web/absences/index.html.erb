<div class="settings-container">
  <div class="d-flex d-wrap justify-content-between mb-5">
    <h1 class="settings-title mb-0">Congés</h1>
      <%= link_to new_absence_path(), class:'btn btn-blue btn-sm btn-add btn-text-white',
        data: { controller:'absences', action:'click->absences#showModal', turbo_frame: 'modal', turbo: 'false' } do %>
      <%= inline_svg_tag('icons/add.svg') %>
      Déclarer un congé
    <% end %>
  </div>

  <%= search_form_for @q, url: absences_path(), method: :get,
      data: { controller: "search", search_url: absences_path() } do |form| %>

    <div class="prestations-type d-flex align-content-center justify-content-center">
      <div class="form-check form-check-inline">
        <%= label_tag 'all-filter', class: 'form-check-label all' do %>
          <%= radio_button_tag :state, '', class: 'form-check-input', id: 'all-filter',
              data: { action: 'change->search#getByState' } %>
          <span class='type-status-value'>Tout</span>
          <div class="after"></div>
        <% end %>
      </div>
      <div class="separation"></div>
      <div class="form-check form-check-inline">
        <%= label_tag 'pending-filter', class: 'form-check-label service' do %>
          <%= radio_button_tag :state, '0', class: 'form-check-input', id: 'pending-filter',
              data: { action: 'change->search#getByState' } %>
          <span class='type-status-value'>En cours</span>
          <div class="after"></div>
        <% end %>
      </div>
      <div class="separation"></div>
      <div class="form-check form-check-inline">
        <%= label_tag 'allowed-filter', class: 'form-check-label rent' do %>
          <%= radio_button_tag :state, '1', class: 'form-check-input', id: 'allowed-filter',
              data: { action: 'change->search#getByState' } %>
          <span class='type-status-value'>Accordé</span>
          <div class="after"></div>
        <% end %>
      </div>
      <div class="separation"></div>
      <div class="form-check form-check-inline">
        <%= label_tag 'refused-filter', class: 'form-check-label sell' do %>
          <%= radio_button_tag :state, '2', class: 'form-check-input', id: 'refused-filter',
              data: { action: 'change->search#getByState' } %>
          <span class='type-status-value'>Refusé</span>
          <div class="after"></div>
        <% end %>
      </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <h4 class='m-0'>Liste des absences</h4>
      <div class="search-input w-350">
        <%= form.search_field :user_name_cont, class: 'form-control', placeholder: 'Rechercher',
            aria: { label: 'search by type_absence or state', describedby: 'button-addon-2' },
            data: { action: "input->search#search", search_target: "input" } %>
        <i class="search-icon">
          <%= inline_svg_tag('icons/search.svg') %>
        </i>
      </div>
    </div>

    <%= turbo_frame_tag 'cover-absences-list' do %>
      <%= render 'absence', absences: @absences %>
      <% if @count > 10 %>
        <footer class="d-flex align-items-center justify-content-between p-4">
          <div class="cover-pagination">
            <%= will_paginate @prestations, renderer: BootstrapPaginationHelper::BootstrapLinkRenderer %>
          </div>

          <div class='w-25 d-flex align-items-center justify-content-end'>
            <label class='text-gray-dark me-2'>Affichage :</label>
            <%= select_tag :items, options_for_select([10, 20, 30, 40, 50], params[:items]),
              data: { action: "change->search#changeItemsPerPage", search_target: "itemsPerPage" },
              class: "w-25 ml-auto form-select" %>
          </div>
        </footer>
      <% end %>
    <% end %>
  <% end %>
</div>
