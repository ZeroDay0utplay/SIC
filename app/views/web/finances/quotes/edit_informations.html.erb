<div class="finance-container" data-controller="finance">
  <div class="finance-head">
    <h1>Création de devis</h1>
    <%= render 'steps' %>
  </div>
  <div class="finance-card">
    <%= form_for @quote, url: update_informations_finances_quote_path(), method: :put do |form| %>
      <div class="cover-admin-clients row mb-5">
        <div class="col-sm-12 col-md-6">
          <div class="d-flex flex-column cover-multi-select mb-3">
            <%= form.label :prestation_id, "Prestation:", class: "form-label" %>
            <div class="d-flex align-items-center">
              <%= form.select :prestation_id,
                [['Veuillez sélectionner', '0', { disabled: true, selected: true }]] + Prestation.current_company.order(:name).map { |prestation| [prestation.name, prestation.id] },
                {}, required: true, class: "form-select prestation-select me-2"
              %>
              <%= link_to modal_new_settings_prestations_path(), class:'btn btn-text-white btn-blue-dark btn-sm btn-add', data: { controller:'modals', action: 'click->modals#showModal', turbo_frame: 'modal', turbo: 'false'} do %>
                <%= inline_svg_tag('icons/add.svg') %>
              <% end %>
            </div>
          </div>
          <div class="d-flex flex-column">
            <%= form.label :contacts, "Contacts:", class: "form-label" %>
            <div class="d-flex align-items-center">
              <%= render 'web/shared/contacts_list',
                contacts: @quote.client.contacts,
                model: @quote.class.name.downcase,
                type: 'primary',
                selected: @quote.contacts.ids %>
              <%= link_to modal_new_settings_contacts_path(), class:'btn btn-text-white btn-blue-dark btn-sm btn-add ms-2', data: { controller:'modals', action: 'click->modals#showModal', turbo_frame: 'modal', turbo: 'false'} do %>
                <%= inline_svg_tag('icons/add.svg') %>
              <% end %>
            </div>
          </div>
        </div>
        <div class="col-sm-12 col-md-6">
          <div class="d-flex flex-column mb-3">
            <label class="form-label">Site d'intervention</label>
            <%= render 'web/shared/interventions_list',
                interventions: @quote.client.interventions,
                model: @quote.class.name.downcase,
                address: @quote.intervention.present? ? @quote.intervention.address.formatted_address : "",
                selected: @quote.intervention_id %>
          </div>
          <div class="d-flex flex-column mb-3">
            <label class="form-label">Ou entrez l'adresse</label>
            <%= form.fields_for :address do |fields_for| %>
              <%= fields_for.text_field :entered_by_user, class: "form-control", placeholder: "Adresse" %>
            <% end %>
          </div>
        </div>
      </div>
      <div class="text-end">
        <%= link_to edit_finances_quote_path(@quote),
            class:"btn btn-md btn-outline-secondary btn-cancel btn-text-white",
            data: {turbo: false} do %>
          Retour
        <% end %>
        <%= form.button type: "submit", class: "btn btn-md mx-2 btn-save btn-text-white btn-blue-dark" do %>
          Suivant
          <%= inline_svg_tag("icons/arrow-right.svg") %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>