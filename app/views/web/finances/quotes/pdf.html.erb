<!-- app/views/factures/generate.html.erb -->
<html lang="fr">
  <head>
    <meta charset="UTF-8">
    <title><%= @quote.reference %></title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;700" rel="stylesheet">
    <style>
      body {
        font-family: Montserrat;
        font-size: 16px;
        line-height: 24px;
        font-style: normal;
      }

      p {
        margin: 0;
        line-height: 20px;
      }

      .factures-details {
        width: 100%;
        color: #000;
        font-size: 15px;
        font-weight: 500;
        margin-bottom: 40px;
      }

      .factures-details td {
        padding: 10px
      }

      .montant-details {
        width: 400px;
        max-width: 400px;
        margin: 40px 0 0 auto;
      }
    </style>
  </head>
  <body>
    <section>
      <table style="width: 100%;">
        <tr>
          <td>
            <% if current_company.logo.present? %>
              <%= image_tag image_url(current_company.logo), style: "width: 182.051px; object-fit: cover" %>
            <% else %>
              <%= image_tag image_url('logo.png'), style: "width: 182.051px; object-fit: cover" %>
            <% end %>
          </td>
          <td style="width: 40%; color: #000; font-size: 16px; font-style: normal; font-weight: 700; line-height: 20px;">
            <br>
            <p><span style="font-weight: 700;">quote</span> <span style="font-weight: 500;"><%= @quote.reference %> </span></p>

                <p style="font-weight: 500;">
                  En date du: <%= @quote.created_at.strftime("%d/%m/%Y") %></p>
              </div>
            </div>
          </td>
        </tr>
        <tr>
          <td style="color: #000; font-size: 16px; font-style: normal; font-weight: 500; line-height: 24px;">
            <br>
            <p style="color: #888E95; font-size: 14px; letter-spacing: -0.21px;">Emetteur : </p>
            <p style="text-transform: uppercase;"><b><%= @company.social_reason %></b></p>

            <p><%= @company.email %></p>
            <p><%= @company.tel %></p>

            <p style="font-weight: 700;padding-top: 20px;">
              <span>Votre référent :</span> <%= "" %>
            </p>
            <p>Mobile : <%= @quote.client.name %></p>
            <p>Email : <%= @quote.client.name %></p>
          </td>
          <td style="width: 40%; color: #000;  font-weight: 500;">
            <p style="color: #888E95; font-size: 14px;">Client : </p>
            <p><%= @quote.client.name %></p>
          </td>
        </tr>
      </table>

      <div style="color: #000; font-size: 16px; margin: 20px 0;">
        <span style="font-weight: 700;">Lieu d'intervention :</span>
        <%= @quote.intervention.address.entered_by_user || @quote.intervention.address.formatted_address %>
      </div>

      <% if @quote.description.present? %>
        <div style="color: #000; font-size: 16px; margin-bottom: 20px">
          <span style="font-weight: 700;">Objet :</span>
          <%= @quote.description %>
        </div>
      <% end %>

      <table class="montant-details" style="text-align: right">
        <tr>
          <td style="font-weight: 700;">Total H.T</td>
          <td style="font-weight: 700; text-align: right;">
            <%=@quote.price_pretax %>
          </td>
        </tr>
        <tr>
          <td style="font-weight: 700;">Remise générale</td>
          <td style="font-weight: 700; text-align: right;">
            <%=@quote.global_reduction %>
          </td>
        </tr>
        <tr>
          <td style="font-weight: 700;">Total TVA</td>
          <td style="font-weight: 700; text-align: right;">
            <%= @quote.tax_price %>
          </td>
        </tr>
        <tr>
          <td style="font-weight: 700;">Total TTC</td>
          <td style="font-weight: 700; text-align: right;">
            <%= @quote.total_price %>
          </td>
        </tr>

      </table>

    </section>
  </body>
</html>