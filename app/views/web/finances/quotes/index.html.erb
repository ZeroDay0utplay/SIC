<div class="settings-container finances-quotes">
  <div class="d-flex d-wrap justify-content-between mb-3">
    <h1 class="settings-title mb-0">Invoices</h1>
  </div>
  <%= search_form_for @q, url: finances_quotes_path(), method: :get,
      data: { controller: "search", search_url: finances_quotes_path() } do |form| %>

    <div class="finances-status d-flex align-content-center justify-content-center">
      <div class="form-check form-check-inline">
        <%= label_tag 'all-filter', class: 'form-check-label blue-dark-status' do %>
          <%= radio_button_tag :state, '', class: 'form-check-input', checked: true, id: 'all-filter',
              data: { action: 'change->search#getByState' } %>
          <span class='type-status-value'>All</span>
          <div class="after"></div>
        <% end %>
      </div>
      <div class="separation"></div>
      <div class="form-check form-check-inline">
        <%= label_tag 'send-filter', class: 'form-check-label green-status' do %>
          <%= radio_button_tag :state, '1', class: 'form-check-input', id: 'send-filter',
              data: { action: 'change->search#getByState' } %>
          <span class='type-status-value'>Sent</span>
          <div class="after"></div>
        <% end %>
      </div>
      <div class="separation"></div>
      <div class="form-check form-check-inline">
        <%= label_tag 'pending-filter', class: 'form-check-label yellow-status' do %>
          <%= radio_button_tag :state, '2', class: 'form-check-input', id: 'pending-filter',
              data: { action: 'change->search#getByState' } %>
          <span class='type-status-value'>Pending</span>
          <div class="after"></div>
        <% end %>
      </div>
      <div class="separation"></div>
      <div class="form-check form-check-inline">
        <%= label_tag 'draft-filter', class: 'form-check-label red-status' do %>
          <%= radio_button_tag :state, '0', class: 'form-check-input', id: 'draft-filter',
              data: { action: 'change->search#getByState' } %>
          <span class='type-status-value'>Draft</span>
          <div class="after"></div>
        <% end %>
      </div>
    </div>

    <div class="d-flex flex-wrap align-items-end my-3">
      <div class="col-sm-12 col-md-4 col-lg-3">
        <label class='form-label'">Date</label>
        <div class="m-0" id="filter_quote_dates">
          <div class="input-group">
            <input
              style='text-align: center; font-weight: bold;'
              type="text"
              placeholder="jj-mm-aaaa"
              class="form-control flatpickr-input"
              data-search-target="date"
              data-action="focus->search#filterDate">
            <div class="input-group-text bg-primary-transparent">
              <%= inline_svg_tag('icons/devis-calendar.svg') %>
            </div>
          </div>
        </div>
      </div>

      <div class="col-4"></div>

      <div class="col-sm-12 col-md-8 col-lg-5 d-flex justify-content-end">
        <div class="search-input w-350">
          <%= form.search_field :combined_search_cont, class: 'form-control', placeholder: 'Rechercher',
          aria: { label: 'search by client_name', describedby: 'button-addon-2' },
          data: { action: "input->search#search", search_target: "input" } %>
          <i class="search-icon">
        <%= inline_svg_tag('icons/search.svg') %>
          </i>
        </div>
      </div>

    </div>

    <div>
      <%= render "shared/skeleton_loader" %>

      <div data-search-target="skeletonTable">

        <%= turbo_frame_tag 'cover-quotes-list' do %>
          <%= render 'quotes', quotes: @quotes %>
          <% if @count > 10 %>
            <footer class="d-flex align-items-center justify-content-between p-4">
              <div class="cover-pagination">
                <%= will_paginate @quotes, renderer: BootstrapPaginationHelper::BootstrapLinkRenderer %>
              </div>

              <div class='w-25 d-flex align-items-center justify-content-end'>
                <label class='text-gray-dark me-2'>Affichage :</label>
                <%= select_tag :items, options_for_select([10, 20, 30, 40, 50], params[:items]),
                  data: { action: "change->search#changeItemsPerPage", search_target: "itemsPerPage" },
                  class: "w-25 ml-auto form-select" %>
              </div>
            </footer>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>