<div class="finance-container" data-controller="finance commercial-catalogue">
  <div class="finance-head">
    <h1>Création de devis</h1>
    <%= render 'steps' %>
  </div>

  <%= form_for @quote, url: update_prestations_finances_quote_path(), method: :put,  data: { turbo: false } do |form| %>
    <%= form.fields_for :commercial_detail do |form_detail| %>
      <div class="cover-settings text-end mb-3">
        <div class="btn-group dropstart">
          <div class="d-inline-block dropdown-toggle" role="button" id="dropdownMenuClickableInside" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
            <%= inline_svg_tag("icons/settings.svg") %>
            Paramètres
          </div>

          <%= render 'commercial_detail', form_detail: form_detail %>
        </div>
      </div>
    <% end %>

    <div class="finance-card">
      <div>
        <div data-controller="sortable-item" id="items-container" data-finance-target="itemsContainer">
          <%= form.fields_for :items, @quote.items.includes(:prestation).sort_by(&:order) do |item_form| %>
            <!-- BEGIN ITEM -->
            <div class="cover-quote-item flex-column align-items-start" id="quote-item-<%= item_form.object.id %>" data-controller="finance-item">
              <%= item_form.hidden_field :id %>
              <%= item_form.hidden_field :order, value: item_form.object.order %>
              <div class="quote-item-header d-flex justify-content-between align-items-center w-100 mb-3">
                <div class="sortable d-flex align-items-center">
                  <div class="draggable">
                    <%= inline_svg_tag("icons/draggable.svg") %>
                  </div>
                  <div class="order-count" id="order"><%= item_form.index + 1 %></div>
                </div>
                <div class="select-prestation w-75 me-auto ms-3" data-id="${data.id}" id="quote_name${data.id}">
                  <%= item_form.hidden_field :prestation_id, value: item_form.object.prestation_id %>
                  <div class="prestation-name">
                    <%= item_form.object.prestation.name %>
                  </div>
                </div>
                <div class="delete-duplicate d-flex align-items-center">
                  <div class="delete d-flex align-items-center justify-content-center pointer" data-action="click->finance#removeItem click->finance-item#updateTotalPrice">
                    <%= inline_svg_tag("icons/trash-can.svg") %>
                  </div>
                  <div class="duplicate d-flex align-items-center justify-content-center ms-2 pointer">
                    <%= inline_svg_tag("icons/copy.svg") %>
                  </div>
                </div>
              </div>
              <div class="quote-item-details mb-2 w-100">
                <div class="quote-item-grid">
                  <div class="item-label first-child">Quantité</div>
                  <div class="item-label">Prix HT</div>
                  <div class="item-label">Unité</div>
                  <div class="item-label">Jours</div>
                  <div class="item-label">Réduction</div>
                  <div class="item-label last-child">
                    <div class="prices-pretax <%= 'd-none' unless @quote.commercial_detail.display_total_with_tax %>">
                      Total HT
                    </div>
                  </div>

                  <div class="item-input">
                    <%= item_form.number_field :quantity, class: "form-control", min: 1, placeholder: "1", data: { finance_item_target: "quantity", action: "change->finance-item#updatePrice" } %>
                  </div>

                  <div class="item-input">
                    <%= item_form.number_field :unit_price, class: "form-control", min: 1, placeholder: "€", data: { finance_item_target: "unitPrice", action: "change->finance-item#updatePrice" } %>
                  </div>

                  <div class="item-input">
                    <%= item_form.select :unit,
                        (Prestation.unities + [item_form.object.unit.to_s]).uniq.map { |unity| [unity, unity] },
                        { include_blank: false },
                        class: "", data: { finance_item_target: "unity" }
                    %>
                  </div>

                  <div class="item-input">
                    <%= item_form.text_field :days, class: "form-control", min: 1, placeholder: "1", data: { finance_item_target: "days", action: "change->finance-item#updatePrice" } %>
                  </div>

                  <div class="item-input d-flex">
                    <%= item_form.number_field :reduction, class: "form-control", min: 0, placeholder: "0", data: { finance_item_target: "reduction", action: "change->finance-item#updatePrice" }, disabled: !item_form.object.has_reduction %>

                    <%= item_form.select :reduction_unit, { "€" => "currency", "%" => "percentage" }, {}, class: "form-select ms-1", disabled: !item_form.object.has_reduction, data: { finance_item_target: "reductionUnit", action: "change->finance-item#updatePrice" } %>
                  </div>

                  <div class="item-input">
                    <div class="form-control prices-pretax <%= 'd-none' unless @quote.commercial_detail.display_total_with_tax %>" data-finance-item-target="pricePretax">0</div>
                    <input type="hidden" name="inputPricePretax" class="input-price-pretax"
                      data-finance-item-target="inputPricePretax"
                      data-action="change->finance-item#updateTotalPrice">
                  </div>
                </div>
              </div>
              <div class="quote-item-description d-flex align-items-center w-100">
                <div class="quote-description">
                  <%= item_form.rich_text_area :description, data: { controller: 'trix-toolbar'}, value: item_form.object.description, class: "form-control" %>
                </div>
                <div class="description-reduction d-flex flex-column ms-2">
                  <label class="user-select-none pointer">
                    <%= item_form.check_box :has_description, data: { finance_item_target: "hasDescription", action: "change->finance-item#showDescription" }, checked: true %>
                    Ajouter une description
                  </label>
                  <label class="user-select-none pointer">
                    <%= item_form.check_box :has_reduction, data: { finance_item_target: "hasReduction", action: "change->finance-item#showReduction change->finance-item#updatePrice" } %>
                    Appliquer une remise
                  </label>
                </div>
              </div>
            </div>
            <!-- END ITEM -->
          <% end %>
        </div>

        <div class="d-flex align-items-center">
          <div data-action="click->commercial-catalogue#getCatalogue" class="add-item-button pointer d-flex align-items-center">
            <%= inline_svg_tag("icons/add.svg") %>
            Ajouter une ligne
          </div>
        </div>
      </div>

      <div class="footer-quote row">
        <div class="col-sm-12 col-md-6 quote-tax">
          <table>
            <thead>
              <tr>
                <th>Taux</th>
                <th>Montant TVA</th>
                <th>Base HT</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><div id="tax"><%= current_company.taux_tva || 0 %>%</div></td>
                <td><div id="left-total-tax">0€</div></td>
                <td><div id="left-prcie-pretax">0€</div></td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="quote-summary col-sm-12 col-md-6">
          <table class="ms-auto">
            <tr>
              <td class="p-3">
                <label>
                  Remise générale
                </label>
                </td>
              <td>
                <div class="item-input d-flex">
                  <%= form.number_field :reduction, class: "form-control", min: 0, placeholder: "0",
                      disabled: !@quote.commercial_detail.display_global_discount,
                      data: { finance_item_target: "reduction", action: "change->finance#updateTotalPrice" } %>

                  <%= form.select :reduction_unit, { "€" => "currency", "%" => "percentage" }, {}, class: "form-select ms-1",
                      disabled: !@quote.commercial_detail.display_global_discount,
                      data: { finance_item_target: "reductionUnit", action: "change->finance#updateTotalPrice" } %>
                </div>
              </td>
            </tr>
            <tr>
              <td class="p-3 text-start">
                <label>
                  Total HT
                </label>
              </td>
              <td>
                <div class="text-end" id="right-price-pretax">0€</div>
              </td>
            </tr>
            <tr>
              <td class="p-3 text-start">
                <label>
                  Remise générale
                </label>
              </td>
              <td>
                <div class="text-end" id="right-global-reduction">0€</div>
              </td>
            </tr>
            <tr>
              <td class="p-3 text-start">
                <label>
                  Total TVA
                </label>
              </td>
              <td>
                <div class="text-end" id="right-total-tax">0€</div>
              </td>
            </tr>
            <tr class="border-top">
              <td class="p-3 text-start">
                <label>
                  Total TTC
                </label>
              </td>
              <td>
                <div class="text-end" id="right-total-prcie">0€</div>
              </td>
            </tr>
          </table>

        </div>
      </div>

      <div class="d-flex flex-column">
        <div class="mb-3 d-flex flex-column align-items-end justify-content-end convert-to-template">
          <div class="ideo-checkbox">
            <%= form.label :use_as_template, class:"user-select-none pointer d-flex align-items-center justify-content-between" do %>
              Enregister comme model
              <%= form.checkbox :use_as_template, checked: !@quote.template_id.nil? , data: { action:"change->finance#useAsTemplate" }, class:"d-none" %>
              <span class="toggle ms-3"></span>
            <% end %>
          </div>
          <div class="w-50 form-controle my-3">
            <%= form.text_field :template_name, value: @quote&.template&.template_name || "",
                class: "form-control ms-2 #{'d-none' if @quote.template_id.nil?}",
                placeholder: "Nom du modèle", data: { finance_target: "templateName"} %>
          </div>
        </div>
        <div class="text-end">
          <%= link_to edit_informations_finances_quote_path(@quote), class: "btn btn-md btn-outline-secondary btn-cancel btn-text-white", data: { turbo: false } do %>
            Retour
          <% end %>
          <%= form.button type: "submit", class: "btn btn-md mx-2 btn-save btn-text-white btn-blue-dark" do %>
            Enregistrer
            <%= inline_svg_tag("icons/save.svg") %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>
