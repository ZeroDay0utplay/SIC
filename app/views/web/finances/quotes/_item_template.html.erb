<%= turbo_stream.append "items-container" do %>
  <div class="cover-quote-item flex-column" data-controller="finance-item">
    <input type="hidden" id="quote_items_attributes___INDEX___order" name="quote[items_attributes][__INDEX__][order]">
    <div class="quote-item-header d-flex justify-content-between align-items-center w-100 mb-3">
      <div class="sortable d-flex align-items-center">
        <div class="draggable">
          <%= inline_svg_tag("icons/draggable.svg") %>
        </div>
        <div class="order-count" id="order">__INDEX__</div>
      </div>
      <div class="select-prestation w-75 me-auto ms-3">
        <div class="prestation-name">
          <%= @prestation.name %>
        </div>
        <input type="hidden" value="<%= @prestation.id %>" name="quote[items_attributes][__INDEX__][prestation_id]">
      </div>
      <div class="delete-duplicate d-flex align-items-center">
        <div class="delete d-flex align-items-center justify-content-center pointer"
              data-action="click->finance#removeItem click->finance-item#updateTotalPrice">
          <%= inline_svg_tag("icons/trash-can.svg") %>
        </div>
        <div class="duplicate d-flex align-items-center justify-content-center ms-2 pointer">
          <%= inline_svg_tag("icons/copy.svg") %>
        </div>
      </div>
    </div>
    <div class="quote-item-details mb-2 w-100">
      <div class="quote-item-grid">
        <div class="item-label first-child">Quantité</div>
        <div class="item-label">Prix HT</div>
        <div class="item-label">Unité</div>
        <div class="item-label">Jours</div>
        <div class="item-label">Réduction</div>
        <div class="item-label last-child">
          <div class="prices-pretax">
            Total HT
          </div>
        </div>

        <div class="item-input">
          <input type="number" class="form-control" min="0" placeholder="0"
                  name="quote[items_attributes][__INDEX__][quantity]"
                  data-finance-item-target="quantity"
                  data-action="change->finance-item#updatePrice">
        </div>

        <div class="item-input">
          <input type="number" class="form-control" min="0" placeholder="€"
                  name="quote[items_attributes][__INDEX__][unit_price]"
                  value=<%= @prestation.price %>
                  data-finance-item-target="unitPrice"
                  data-action="change->finance-item#updatePrice">
        </div>

        <div class="item-input">
          <select name="quote[items_attributes][__INDEX__][unit]" class="form-select" data-finance-item-target="unity">
            <% (Prestation.unities + [@prestation.unity.to_s]).uniq.each do |unity| %>
              <option value="<%= unity %>" <%= "selected" if @prestation.unity.to_s == unity %>><%= unity %></option>
            <% end %>
          </select>

        </div>

        <div class="item-input">
          <input type="number" class="form-control" min="1" placeholder="0"
                  name="quote[items_attributes][__INDEX__][days]"
                  data-finance-item-target="days"
                  data-action="change->finance-item#updatePrice">
        </div>

        <div class="item-input d-flex">
          <input type="number" class="form-control" min="0" placeholder="0"
                  name="quote[items_attributes][__INDEX__][reduction]"
                  data-finance-item-target="reduction"
                  data-action="change->finance-item#updatePrice" disabled>

          <select class="form-select ms-1" disabled
                  name="quote[items_attributes][__INDEX__][reduction_unit]"
                  data-finance-item-target="reductionUnit"
                  data-action="change->finance-item#updatePrice">
            <option value="currency">€</option>
            <option value="percentage">%</option>
          </select>
        </div>

        <div class="item-input">
          <div class="form-control prices-pretax" data-finance-item-target="pricePretax">0</div>
          <input type="hidden" name="quote[items_attributes][__INDEX__][inputPricePretax]"
                  class="input-price-pretax"
                  data-finance-item-target="inputPricePretax"
                  data-action="change->finance-item#updateTotalPrice">
        </div>
      </div>
    </div>
    <div class="quote-item-description d-flex align-items-center w-100">
      <div class="quote-description">
        <trix-editor
          input="description"
          data-controller="trix-toolbar"
          class="form-control"
        ></trix-editor>
        <input id="description" type="hidden" name="quote[items_attributes][__INDEX__][description]" value="<%= @prestation.description %>" />
      </div>

      <div class="description-reduction d-flex flex-column ms-2">
        <label class="user-select-none pointer">
          <input type="checkbox" name="quote[items_attributes][__INDEX__][has_description]"
                  data-finance-item-target="hasDescription"
                  data-action="change->finance-item#showDescription" checked>
          Ajouter une description
        </label>
        <label class="user-select-none pointer">
          <input type="checkbox" name="quote[items_attributes][__INDEX__][has_reduction]"
                  data-finance-item-target="hasReduction"
                  data-action="change->finance-item#showReduction">
          Appliquer une remise
        </label>
      </div>
    </div>
  </div>
<% end %>
