<div class="tab-content" id="myTabContent">
  <!-- *********************************************************************** -->
  <div class="tab-pane fade show active pt-5" id="service" role="tabpanel" aria-labelledby="service-tab">
    <% prestations.service.each do |item| %>
      <div  class="p-2 prestation-item d-none" data-commercial-catalogue-target="prestationItem"
            data-action="click->commercial-catalogue#setPrestation click->bs-modal#removeModal"
            data-value="<%= item.id %>">
        <%= item.name %>
      </div>
    <% end %>
    <label class="px-2 text-gray">Les plus utilisés</label>
    <% prestations.service.each do |item| %>
      <div  class="p-2 prestation-item"
            data-action="click->commercial-catalogue#setPrestation click->bs-modal#removeModal"
            data-value="<%= item.id %>">
        <%= item.name %>
      </div>
    <% end %>
  </div>
