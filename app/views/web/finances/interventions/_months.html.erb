<div class="month-filters d-flex flex-column justify-content-center">
  <h6 class="me-auto">Mois</h6>
  <input type="hidden" data-search-target="selectedMonths">

  <% months = [
    'Janvier', 'Février', 'Mars', 'Avril',
    'Mai', 'Juin', 'Juillet', 'Août',
    'Septembre', 'Octobre', 'Novembre', 'Décembre'
  ] %>

  <div class="months-list d-flex flex-wrap">
    <% months.each_with_index do |name, index| %>
      <% id = "filter-month_#{name.downcase}" %>
      <label class="month text-center" for="<%= id %>">
        <input type="checkbox"
          class="btn-check filter-month"
          id="<%= id %>"
          <%= 'checked' if Date.current.month == index + 1 %>
          data-search-target="months"
          data-action="click->search#filterByMonth"
          value="<%= index %>">
        <span class="after"></span>
        <span class="text"><%= name %></span>
      </label>
    <% end %>
  </div>
</div>
