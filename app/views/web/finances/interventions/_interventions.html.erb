<div class="interventions-list">
  <% if interventions.empty? %>
    <h3 class="text-center p-5">Aucune intervention à afficher</h3>
  <% else %>
    <table class="table ideo-table">
      <thead class='thead-success'>
        <tr>
          <th>ID</th>
          <th>Groupe</th>
          <th>Adresse</th>
          <th>Intitulé</th>
          <th>Première date</th>
          <th>Status</th>
          <th>Editeur</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody id="interventions-list" class='align-middle'>
        <% @interventions.each do |intervention| %>
          <tr id="intervention-<%= intervention.id %>">
            <td>
              <%= intervention.id %>
            </td>
            <td>
              <%= intervention.client.name %>
            </td>
            <td>
              <small><%= intervention.formatted_address %></small>
            </td>
            <td>
              <%= intervention.heading.title %>
            </td>
            <td>
              <%= "jj/mm/aaaa" %>
            </td>
            <td>
              <%= "statut" %>
            </td>
            <td>
              <%= intervention.author %>
            </td>
            <td>
              <%= link_to finances_intervention_path(intervention.id), class: 'icon-ideo icon-blue icon-20' do %>
                <%= inline_svg_tag("icons/view.svg") %>
              <% end %>
              <%= link_to finances_intervention_path(intervention.id),
                  class: 'icon-ideo icon-destroy icon-red icon-20',
                  data: { controller:'confirm-modal', action:'click->confirm-modal#confirmDestroy',
                          confirm_modal_target:'itemToBeRemoved',
                          value: "intervention-#{intervention.id}",
                          turbo_frame: 'modal', turbo: 'false'} do %>
                <%= inline_svg_tag('icons/trash-can.svg') %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
