<div class="punctuals-list">
  <table class="table ideo-table">
    <thead class='thead-success'>
      <tr>
        <th>
          <input type="checkbox" name="select-all" id="select-all">
        </th>
        <th>Date</th>
        <th>Client</th>
        <th>Adresse</th>
        <th>Prestation</th>
        <th>Auto-dis</th>
        <th>Agents</th>
        <th>Retour</th>
        <th>Capacité</th>
        <th>Véhicule</th>
        <th></th>
      </tr>
    </thead>
    <tbody id="punctuals-list" class='align-middle'>
      <% @punctuals.each do |punctual| %>
        <tr id="punctual-<%= punctual.id %>">
          <td>
            <input type="checkbox" id="punctual-<%= punctual.id %>">
          </td>
          <td><%= punctual&.schedule&.date %></td>
          <td><%= punctual.client.name %></td>
          <td>
            <div class="mission-address">
              <%= punctual.intervention.address.formatted_address %>
            </div>
          </td>
          <td><%= punctual.prestation.name %></td>
          <td>
            <div class="dispatch-manual <%= "active" unless punctual.manual_dispatch %>">
              <% unless punctual.manual_dispatch %>
                <%= inline_svg_tag("icons/checkmark-filled.svg") %>
              <% else %>
                <%= inline_svg_tag("icons/checkmark-outline.svg") %>
              <% end %>
            </div>
          </td>
          <td>

            <% unless punctual.schedule.agents.count.zero? %>
              <div class="dropdown agents-list">
                <button class="btn btn-blue btn-see-agent btn-xs btn-text-white dropdown-toggle" type="button" id="dropdownMenuButton1" data-bs-toggle="dropdown" aria-expanded="false">
                  <%= inline_svg_tag("icons/list.svg") %>
                  Voir
                </button>
                <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton1">
                  <% punctual.schedule.agents.each do |agent| %>
                    <li><%= agent.full_name %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

          </td>
          <td></td>
          <td>
            <%= "#{ punctual.schedule.agents.count } / #{ punctual.agent_needed }(A)" %>
          </td>
          <td>
            <%= punctual.vehicles.count %>
          </td>
          <td>
            <%= link_to "#", class:'icon-ideo icon-edit icon-blue icon-20',
                data: { turbo: 'false'}  do %>
              <%= inline_svg_tag ('icons/copy.svg') %>
            <% end %>

            <%= link_to "#", class:'icon-ideo icon-edit icon-blue icon-20',
                data: { turbo: 'false'}  do %>
              <%= inline_svg_tag ('icons/view.svg') %>
            <% end %>

            <%= link_to "#", class:'icon-ideo icon-edit icon-blue icon-20',
                data: { turbo: 'false'}  do %>
              <%= inline_svg_tag ('icons/edit.svg') %>
            <% end %>

            <%= link_to plannings_punctual_path(punctual), class: 'icon-ideo icon-stroke-red icon-red icon-16',
                data: { controller:'confirm-modal', action:'click->confirm-modal#confirmDestroy',
                        confirm_modal_target:'itemToBeRemoved',
                        value: "punctual-#{punctual.id}",
                        turbo_frame: 'modal', turbo: 'false'} do %>
              <%= inline_svg_tag('icons/destroy.svg') %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

