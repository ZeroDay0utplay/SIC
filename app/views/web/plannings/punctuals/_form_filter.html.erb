<div class="d-flex flex-column">
  <div class="d-flex mb-3">
    <div class="w-50 d-flex align-items-center">
      <% if controller.controller_name == "punctuals" %>
        <div class="agents-counter d-flex align-items-center">
          <label>Agents J+1</label>
          <div class="d-flex agent-status">
            <strong>10</strong>
            <span>Disponibles</span>
          </div>
          <div class="d-flex agent-status deficit">
            <strong>8</strong>
            <span>Déficit</span>
          </div>
        </div>
      <% end %>
    </div>
    <div class="d-flex justify-content-end align-items-center w-50">
      <%= form_with url: plannings_punctuals_path, method: :get,
          data: { search_url: plannings_punctuals_path } do |form| %>
        <div class="search-input w-350">
          <%= form.search_field :q, class: 'form-control', placeholder: 'Rechercher',
              aria: { label: 'search by name or company', describedby: 'button-addon-2' },
              data: { action: "input->search#search", search_target: "input" } %>
          <i class="search-icon">
            <%= inline_svg_tag('icons/search.svg') %>
          </i>
        </div>
      <% end %>

      <button class="btn btn-blue btn-sm btn-add btn-text-white ms-3">
        <%= inline_svg_tag("icons/workflow-automation.svg") %>
        Auto-dispatcher
      </button>
    </div>
  </div>

  <div class="d-flex justify-content-start flex-wraper mb-3">
    <div class="form-group w-50 pe-2">
      <div class="w-50">
        <label for="start_on" class="form-label">Date</label>
        <input type="date" name="dates" id="dates" class="form-control"
          placeholder="jj-mm-aaaa"
          data-punctuals-target="multipleDateInput"
          data-search-target="multipleDateInput"
          data-action="change->search#search" >
      </div>
    </div>

    <div class="form-group w-25 ms-auto">
      <label class="mb-4 d-block"></label>
      <label for="agents-list" class="d-flex align-items-center user-select-none pointer">
        <input type="checkbox" name="agents-list" id="agents-list">
        <span class="ms-2">liste des agents</span>
      </label>
      <label for="subcontractors-list" class="d-flex align-items-center user-select-none pointer">
        <input type="checkbox" name="subcontractors-list" id="subcontractors-list">
        <span class="ms-2">liste des sous-traitants</span>
      </label>
    </div>
    <div class="form-group d-flex align-items-center justify-content-end w-25">
      <label for="display-mode" class="me-2">Affichage :</label>
      <select name="display-mode" id="display-mode" class="form-select w-50">
        <option value="0">Condensé</option>
      </select>
    </div>
  </div>
</div>
