

<div class="d-flex flex-column">
  <div class="d-flex justify-content-start flex-wraper mb-3">
    <div class="form-group w-25">
      <label for="start_on" class="form-label">Date début</label>
      <input type="date" name="start_on" id="start_on" class="form-control"
        data-search-target="startDate"
        data-action="change->search#getBetweenDates">
    </div>
    <div class="form-group w-25 px-2">
      <label for="finish_on" class="form-label">Date fin</label>
      <input type="date" name="finish_on" id="finish_on" class="form-control"
        data-search-target="endDate"
        data-action="change->search#getBetweenDates">
    </div>
  </div>
</div>
