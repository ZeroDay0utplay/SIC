<div class="regular-mission" data-controller="regular" data-id="<%= @regular.id %>">
  <%= render 'regular_details' %>
  <%= form_for @regular, url: plannings_regular_path(@regular), method: :put, html: {class: "regular-form"}, data: {turbo: false} do |form| %>
    <%= render partial: 'form_edit', locals: { form: form, regular: @regular } %>

    <div class="regular-contacts">

      <div class="assigned-contact">
        <h5>Liste des contacts</h5>

        <div class="contacts-list d-flex algn-items-start flex-wrap">
          <% @regular.planning_contacts.includes(:contact).order(contact_type: :asc).each do |p_contact| %>
            <div class="contact-card <%= p_contact.contact_type %> d-flex flex-column justify-content-center align-items-center">
              <strong><%= p_contact.contact.full_name %></strong>
              <span><%= p_contact.contact.phone %></span>
            </div>
          <% end %>
        </div>

        <% if @regular.tasks.size.zero? %>
          <input type="hidden" id="available-dates"
                  value="<%= @regular.schedules.pluck(:date).map { |d| d.strftime("%Y-%m-%d") }.to_json%>" />

          <div class="mt-4 mb-2 d-flex align-items-center justify-content-between">
            <h4>Liste des agents</h4>
            <input type="search" placeholder="Rechercher" class="form-control w-auto" id="">
          </div>
          <div class="agents-list">
            <%= render 'agents_list', form: form %>
          </div>
        <% end %>

      </div>
    </div>

    <div class="col-12 mt-5 w-100">
      <div class="d-flex justify-content-between justify-content-center">
        <%= form.button type: 'reset', class: "btn btn-sm btn-outline-secondary btn-cancel btn-text-white" do %>
          Annuler
        <% end %>
        <%= form.button type: 'submit', class: "btn btn-sm btn-save btn-text-white btn-blue-dark" do %>
          Suivant
          <%= inline_svg_tag('icons/arrow-right.svg') %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
