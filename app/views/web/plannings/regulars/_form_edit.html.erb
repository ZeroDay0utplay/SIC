<div class="row">
  <div class="col-sm-12 col-md-6 col-lg-4">
    <div class="form-group">
      <%= form.label :start_on, "Date début", class: "form-label" %>
      <div class="form-control">
        <%= @regular.start_on.strftime("%d/%m/%Y") %>
      </div>
    </div>
  </div>
  <div class="col-sm-12 col-md-6 col-lg-4">
    <div class="form-group">
      <%= form.label :finish_on, "Date fin", class: "form-label" %>
      <div class="form-control">
        <%= @regular.finish_on.strftime("%d/%m/%Y") %>
      </div>
    </div>
  </div>
  <div class="col-sm-12 col-md-6 col-lg-4">
    <div class="form-group">
      <%= form.label :prestation_id, "Type de prestation", class: "form-label" %>
      <%= form.select :prestation_id,
        [['Veuillez sélectionner', '0', { disabled: true, selected: true }]] + Prestation.current_company.order(:name).map { |prestation| [prestation.name, prestation.id] },
        {}, required: true, class: "form-select prestation-select me-2"
      %>
    </div>
  </div>

  <div class="col-12 p-3"></div>

  <div class="col-sm-12 col-md-6 col-lg-4">
    <div class="form-group">
      <%= form.label :needs, "Besoin client", class: "form-label" %>
      <%= form.text_area :needs, class: 'form-control' %>
    </div>
  </div>

  <div class="col-sm-12 col-md-6 col-lg-4">
    <div class="form-group">
      <%= form.label :remark, "Remarques", class: "form-label" %>
      <%= form.text_area :remark, class: 'form-control' %>
    </div>
  </div>

  <div class="col-sm-12 col-md-6 col-lg-4">
    <div class="form-group">
      <%= form.label :note, "Note interne", class: "form-label" %>
      <%= form.text_area :note, class: 'form-control' %>
    </div>
  </div>

</div>