<div class="planning-details-header d-flex justify-content-between align-items-center mb-5">
  <div class="details-title"></div>
  <div class="card-customer d-flex align-items-center justify-between">
    <div class="customer-logo">
      <% if @regular.client.logo.attached? %>
        <%= image_tag @regular.client.logo.variant(resize_to_fill: [64, 64]), class: 'rounded-1' %>
      <% else %>
        <%= inline_svg_tag 'icons/logo.svg', width: "64", height: "64" %>
      <% end %>
    </div>
    <div class="card-customer-details">
      <div class="name">
        <%= @regular.client.name %>
      </div>
      <div class="address">
        <%=
          @regular.formatted_address
        %>
      </div>
      <div class="prestation">
        <%= @regular.prestation.name %>
      </div>
    </div>
  </div>
</div>
<% unless @regular.tasks.size.zero? %>
  <div class="steps-navbar p-4 d-flex justify-content-center align-items-center">
    <%= link_to edit_plannings_regular_path(@regular), data: {turbo: false},
        class:"step #{'current' if controller.action_name == 'edit'}" do %>
      <span class="index">
        1
      </span>
      <span class="text">
        Agents
      </span>
    <% end %>
    <div class="separate"></div>
    <%= link_to manage_tasks_agents_plannings_regular_path(@regular), data: {turbo: false},
        class:"step #{'current' if controller.action_name == 'manage_tasks_agents'}" do %>
      <span class="index">
        2
      </span>
      <span class="text">
        Attribution des tâches
      </span>
    <% end %>
  </div>
<% end %>