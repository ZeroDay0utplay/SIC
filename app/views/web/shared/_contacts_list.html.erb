<%= turbo_frame_tag :contacts_list, style: "width: 295px;" do %>
  <div class="cover-multi-select" data-controller="multi-select">
    <input type="text"
          id="quote_contacts_id"
          class="multi-select-input"
          data-multi-select-target="input"
          readonly
          value="<%= (contacts.ids & selected).size %> sélectionné(s)" />
    <div class="dropdown">
      <input type="text"
              placeholder="Rechercher..."
              data-action="input->multi-select#search"
      class="search-box">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <label class="user-select-none">
            <input type="checkbox" data-action="change->multi-select#toggleAll"
            <%= 'checked' if selected.sort == contacts.ids.sort %>
            data-multi-select-target="toggleAll">
            <span data-multi-select-target="toggleAllLabel">
              Tout sélectionner
            </span>
          </label>
        </div>
        <div>
          <button type="button" class="btn btn-blue btn-sm btn-add btn-text-white">
            Ajouter
          </button>
        </div>
      </div>
      <hr>
      <% contacts.map do |contact| %>
        <label class="user-select-none" data-multi-select-target="option">
          <input type="checkbox" name="<%= model %>[<%= type %>-contacts][]"
                  value="<%= contact.id %>"
                  <%= 'checked' if selected.include?(contact.id) %>
                  data-action="change->multi-select#updateSelection">
          <%= contact&.full_name %>
          <%= contact&.id %>
        </label>
      <% end %>
    </div>
  </div>
<% end %>