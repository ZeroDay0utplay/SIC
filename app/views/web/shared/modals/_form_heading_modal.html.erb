<div class="modal-header">
  <h5 class="modal-title">
    Ajouter un client
  </h5>
  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body" data-controller="quotes">
  <%= form.hidden_field :client_id, value: -1 %>
  <div class="row mb-5">
    <div class="col-sm-12 col-md-6">
      <div class="form-group">
        <%= form.label :title, "Titre", class:'form-label'%>
        <%= form.text_field :title, class:'form-control', required: true %>
      </div>
    </div>
    <div class="col-sm-12 col-md-6">
      <div class="form-group">
        <%= form.label :description, "Description", class:'form-label'%>
        <%= form.text_field :description, class:'form-control', required: true %>
      </div>
    </div>
  </div>
</div>
<div class="modal-footer">
  <%= form.button "Annuler", type: 'button', class: "btn btn-lg btn-outline-secondary btn-cancel btn-text-white", data: { bs_dismiss: 'modal' } %>
  <%= form.button type: 'submit', class: "btn btn-lg mx-2 btn-save btn-text-white btn-blue-dark", data: { action: 'bs-modal#submitEnd'} do %>
    Enregistrer
    <%= inline_svg_tag('icons/save.svg') %>
  <% end %>
</div>
<script>
  (function() {
    const observer = new MutationObserver(function(mutations) {
      const clientId = document.getElementById('quote_client_id').value;
      const existingInput = document.getElementById("heading_client_id");

      if (clientId && existingInput) {
        existingInput.value = clientId;
        observer.disconnect();
      }
    });

    observer.observe(document.body, {
      childList: true,
      subtree: true
    });
  })();
</script>
