<div class="modal-header">
  <h5 class="modal-title">
    <%= @contact.persisted? ? "Modifier les informations du contact" : "Ajouter un nouveau contacts" %>
  </h5>
  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body" data-controller="quotes">
  <%= form.hidden_field :quote_id, value: -1 %>
  <div class="row">
    <div class="col-sm-6 col-md-3 col-lg-3">
      <div class="form-group">
        <%= form.label :first_name, "Nom", class: "form-label" %>
        <%= form.text_field :first_name, class: "form-control", required: true %>
      </div>
    </div>
    <div class="col-sm-6 col-md-3 col-lg-3">
      <div class="form-group">
        <%= form.label :last_name, "Prénom", class: "form-label" %>
        <%= form.text_field :last_name, class: "form-control" %>
      </div>
    </div>
    <div class="col-sm-6 col-md-6 col-lg-6">
      <div class="form-group">
        <%= form.label :role, "Rôle", class: "form-label" %>
        <%= form.select :role, ["prospect", "individual", "external", "internal"].map { |role| [role.capitalize, role] }, { prompt: "Choisissez-en un" }, class: "form-control select2-show-search form-select", required: true %>
      </div>
    </div>
  </div>
  <div class="row mt-2">
    <div class="col-sm-5 col-md-5 col-lg-5">
      <div class="form-group">
        <%= form.label :phone, "Téléphone", class: "form-label" %>
        <%= form.text_field :phone, class: "form-control" %>
      </div>
    </div>
    <div class="col-sm-5 col-md-5 col-lg-5">
      <div class="form-group">
        <%= form.label :email, "Email", class: "form-label" %>
        <%= form.email_field :email, class: "form-control" %>
      </div>
    </div>
    
  </div>
  <div class="row mt-2">
    <div class="col-sm-5 col-md-5 col-lg-5">
      <div class="form-group">
        <%= form.label :job, "Fonction", class: "form-label" %>
        <%= form.select :job, Contact.distinct.pluck(:job), { prompt: "Choisissez-en un" }, class: "form-control select2-show-search form-select" %>
      </div>
    </div>
    <div class="col-sm-5 col-md-5 col-lg-5">
      <div class="form-group">
        <%= form.label :company_name, "Nom de la societé", class: "form-label" %>
        <%= form.text_field :company_name, class: "form-control" %>
      </div>
    </div>
  </div>
</div>
<div class="modal-footer">
  <%= form.button "Annuler", type: 'button', class: "btn btn-lg btn-outline-secondary btn-cancel btn-text-white", data: { bs_dismiss: 'modal' } %>
  <%= form.button type: 'submit', class: "btn btn-lg mx-2 btn-save btn-text-white btn-blue-dark", data: { action: 'bs-modal#submitEnd' } do %>
    Enregistrer
    <%= inline_svg_tag('icons/save.svg') %>
  <% end %>
</div>

<script>
(function() {
  const observer = new MutationObserver(function(mutations) {
    const modalBody = document.querySelector('.modal-body');
    if (modalBody) {
      const quoteId = modalBody.dataset.quotesQuoteIdValue;
      const existingInput = document.getElementById('contact_quote_id');
      
      if (quoteId && existingInput) {
        existingInput.value = quoteId;
        observer.disconnect();
      }
    }
  });

  observer.observe(document.body, {
    childList: true,
    subtree: true
  });
})();
</script>