<%= turbo_frame_tag :remote_modal, target: :_top do %>
  <div class="modal fade modal-lg" id="prestation" tabindex="-1" aria-labelledby="prestationModalLabel" aria-hidden="true" data-controller="bs-modal">
    <div class="modal-dialog">
      <div class="modal-content">
        <%= form_for :prestation, url: settings_prestations_path(), method: :patch do |form| %>
          <%= render partial: '/web/shared/modals/form_prestation_modal', locals: { form: form } %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>