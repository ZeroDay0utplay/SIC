<table class='table ideo-table'>
  <thead class='thead-success'>
    <tr>
      <th>ID</th>
      <th><%= sort_link(@q, :name, "Nom") %></th>
      <th>Description</th>
      <th></th>
    </tr>
  </thead>
  <tbody id="mention-legals-list">
    <% @mention_legals.each do |mention_legal| %>
      <tr id="mention-<%= mention_legal.id %>">
        <td><%= mention_legal.id %></td>
        <td>
          <div class="mention-name">
            <%= mention_legal.name %>
          </div>
        </td>
        <td>
          <div class="mention-description">
            <%= mention_legal.description %>
          </div>
        </td>
        <td class="align-content-center">
          <%= link_to edit_settings_mention_legal_path(mention_legal), class:'icon-ideo icon-edit icon-blue', data: { controller:'edit-mention-legal', turbo_frame: 'modal', turbo: 'false'} do %>
            <%= inline_svg_tag ('icons/edit.svg') %>
          <% end %>
          <%= link_to settings_mention_legal_path(mention_legal),
                class: 'icon-ideo icon-destroy icon-red icon-16',
                data: { controller:'confirm-modal', action:'click->confirm-modal#confirmDestroy',
                        confirm_modal_target:'itemToBeRemoved',
                        value: "mention-#{mention_legal.id}",
                        turbo_frame: 'modal', turbo: 'false'} do %>
            <%= inline_svg_tag('icons/trash-can.svg') %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>