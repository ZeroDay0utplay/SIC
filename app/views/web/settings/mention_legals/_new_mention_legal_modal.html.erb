<%= turbo_frame_tag :remote_modal, target: :_top do %>
  <div class="modal fade modal-lg" id="mention-legal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true" data-controller="bs-modal">
    <div class="modal-dialog">
      <div class="modal-content">
        <%= form_for :mention_legal, url: settings_mention_legals_path(), method: :post do |form| %>
          <%= render 'form', form: form %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>