<div class="modal-header">
  <h5 class="modal-title">
    <%= @mention_legal.persisted? ? "Modifier mention légale" : "Nouvelle mention légale" %>
  </h5>
  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body">
    <div class="mb-2">
      <%= form.label :name, "Nom", class: "form-label" %>
      <%= form.text_field :name, class: "form-control" %>
    </div>
    <div class="mb-2">
      <%= form.label :description, "Description", class: "form-label" %>
      <%= form.text_area :description, class: "form-control" %>
    </div>
</div>

<div class="modal-footer">
  <%= form.button type: 'reset', class: "btn btn-lg btn-outline-secondary btn-cancel btn-text-white" do %>
    Annuler
  <% end %>
  <%= form.button type: 'submit', class: "btn btn-lg mx-2 btn-save btn-text-white btn-blue-dark", data: { action: 'bs-modal#submitEnd'} do %>
    Enregistrer
    <%= inline_svg_tag('icons/save.svg') %>
  <% end %>
</div>
