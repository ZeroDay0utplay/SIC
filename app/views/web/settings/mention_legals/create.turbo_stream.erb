<%= turbo_stream.prepend "mention-legals-list" do %>
  <tr id="mention-<%= @mention_legal.id %>">
    <td><%= @mention_legal.id %></td>
    <td><%= @mention_legal.name %></td>
    <td>
      <div class="mention-description">
        <%= @mention_legal.description %>
      </div>
    </td>
    <td>
      <%= link_to edit_settings_mention_legal_path(@mention_legal), data: { controller:'edit-mention-legal', turbo_frame: 'modal', turbo: 'false'} do %>
        <%= inline_svg_tag ('icons/edit.svg') %>
      <% end %>
      <%= link_to settings_mention_legal_path(@mention_legal), method: :delete, data: { turbo_method: :delete, turbo_confirm: 'Are you sure you want to delete this?' } do %>
        <%= inline_svg_tag ('icons/trash-can.svg') %>
      <% end %>
    </td>
  </tr>
<% end %>
