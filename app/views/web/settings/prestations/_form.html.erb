<%= turbo_frame_tag :remote_modal, target: :_top do %>
  <div class="modal fade modal-prestation modal-lg" id="prestation" tabindex="-1" aria-labelledby="prestationModalLabel"
        aria-hidden="false" data-controller="bs-modal">
    <div class="modal-dialog">
      <div class="modal-content">
        <%= form_with(model: [:settings, @prestation], local: true, html: { class: 'form-validate', data: { controller:'form-validate'}}) do |form| %>
          <div class="modal-header">
            <h5 class="modal-title"><%= @prestation.persisted? ? "Modifier prestation" : "Nouvelle prestation" %></h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body" data-controller='prestations'>
            <div class='container'>
              <div class='row'>
                <div class="col-12 col-md-7 d-flex flex-column">
                  <div class="mb-3">
                    <%= form.label :name, 'Nom Prestation', class:'form-label' %>
                    <%= form.text_field :name, class: 'form-control', require: true,
                        data: { action: "blur->form-validate#validate keyup->form-validate#validate", form_validate_target: "input" } %>
                    <span class="error-message" data-form-validate-target="errorMessage"></span>
                  </div>
                  <div class="mb-3">
                    <%= form.label :alias, 'Alias', class:'form-label' %>
                    <%= form.text_field :alias, class: 'form-control', require: true,
                        data: { action: "blur->form-validate#validate keyup->form-validate#validate", form_validate_target: "input" } %>
                    <span class="error-message" data-form-validate-target="errorMessage"></span>
                  </div>
                  <div class="d-flex mb-5">
                    <div>
                      <%= form.label :price, 'Prix', class:'form-label' %>
                      <%= form.number_field :price, class: 'form-control', require: true,
                        data: { action: "blur->form-validate#validate", form_validate_target: "input" } %>
                    <span class="error-message" data-form-validate-target="errorMessage"></span>
                    </div>
                    <div class='mx-2 cover-unity'>
                      <%= form.label :unity, 'Unité', class:'form-label' %>
                      <%= form.select :unity,
                          Prestation.unities.map { |unity| [unity, unity] },
                          { include_blank: false },
                          class: "", data: { prestations_target: "unity" }
                      %>
                      <span class="error-message" data-form-validate-target="errorMessage"></span>
                    </div>
                  </div>
                </div>

                <div class="col-12 col-md-5 d-flex flex-column">
                  <div class='ideo-checkbox-group'>
                    <div class='cover-checkbox'>
                      <% Prestation.type_prestations.keys.each do |type| %>
                        <%= form.label "type_prestation_#{type}".to_sym, class:'d-flex align-items-center mb-2' do %>
                          <%= form.radio_button :type_prestation, type, checked: (@prestation.type_prestation == type),
                              data: { action: "change->form-validate#validate change->prestations#checkTypePrestation", form_validate_target: "radioGroup" } %>
                          <%= inline_svg_tag('icons/checkmark.svg', class:'checkbox') %>
                          <span><%= I18n.t("models.prestation.type_prestation.#{type}") %></span>
                        <% end %>
                      <% end %>
                    </div>
                    <span class="error-message text-danger" data-form-validate-target="radioGroupError"></span>
                  </div>
                  <div class="mb-2 <%= @prestation.type_prestation == 'Location' ? '' : 'd-none' %>" data-prestations-target='prestationState'>
                    <%= form.label :state, 'État', class:'form-label' %>
                    <%= form.select :state, Prestation.states.keys.map { |k| [I18n.t("models.prestation.state.#{k}"), k] }, { include_blank: 'Veuillez sélectionner' }, class: 'form-control' %>
                  </div>
                </div>

                <div class="col-12 d-flex">
                  <div class="w-50">
                    <%= form.label :description, 'Description', class:'form-label' %>
                    <%= form.text_area :description, class: 'form-control', rows: 4 %>
                  </div>
                  <div class="w-50 ms-2">
                    <%= form.label :remark, 'Remarque', class:'form-label' %>
                    <%= form.text_area :remark, class: 'form-control', rows: 4 %>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <%= form.button type: 'reset', class: "btn btn-lg btn-outline-secondary" do %>
              Annuler
            <% end %>
            <%= form.button type: 'submit', class: "btn btn-lg mx-2 btn-save btn-text-white btn-blue-dark",
                disabled: true, data: { action: 'bs-modal#submitEnd', form_validate_target:'submit'} do %>
              Enregistrer
              <%= inline_svg_tag('icons/save.svg') %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
