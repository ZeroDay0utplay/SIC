<%= form_with model: @subcontractor, url: url, method: method,
              html: {class:"form-validate", local: true, data: { controller: "form-validate" }} do |form| %>
  <div class="row mb-3">
    <div class="col-sm-12 col-md-6">
      <div class="mb-3 col-left">
        <%= form.label :company_name, "Raison sociale", class: 'form-label' %>
        <%= form.text_field :company_name, class: 'form-control',
            placeholder: "Raison sociale", require: true,
            data: { action: "blur->form-validate#validate", form_validate_target: "input" } %>
        <span class="error-message" data-form-target="errorMessage"></span>
      </div>

      <div class="mb-3 col-left">
        <%= form.label :manager, "Gérant", class: 'form-label' %>
        <%= form.text_field :manager, class: 'form-control', placeholder: "Gérant", require: true,
            data: { action: "blur->form-validate#validate", form_validate_target: "input" } %>
        <span class="error-message" data-form-target="errorMessage"></span>
      </div>

      <div class="mb-3 col-left">
        <%= form.label :email, "Email", class: 'form-label' %>
        <%= form.email_field :email, class: 'form-control', placeholder: "Email",
            data: {
                action: "blur->form-validate#validate",
                form_validate_target: "input",
                pattern: "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
                errorMessage: "Veuillez entrer une adresse email valide."
              } %>
        <span class="error-message" data-form-target="errorMessage"></span>
      </div>

      <div class="mb-3 col-left">
        <%= form.label :phone, "Téléphone", class: 'form-label' %>
        <%= form.telephone_field :phone, class: 'form-control', placeholder: "+33 1 23 45 67 89" %>
      </div>

      <div class="mb-3 col-left">
        <%= form.label :color, "Couleur", class: 'form-label' %>
        <%= form.color_field :color, class: 'form-control' %>
      </div>
    </div>
    <div class="col-sm-12 col-md-6 ps-lg-5">
      <div class="cover-preview-picture d-flex flex-column justify-content-center align-items-center mb-3" id="cover-preview-picture">
        <label for="edit-avatar" class="text-center">
          <div class="icon rounded-circle d-flex justify-content-center align-items-center m-auto">
            <%= inline_svg_tag('icons/image.svg') %>
          </div>
          <div>
            Glisser et déposer ou <span class="blue">parcourir</span>
          </div>
          <div class="gray">
            PNG ou JPG
          </div>
        </label>
        <%= form.file_field :logo, class: "subcontractor-logo", id: "edit-avatar", accept: 'image/png, image/jpeg' %>
        <% if @subcontractor.logo.attached? %>
          <%= image_tag @subcontractor.logo %>
        <% end %>
      </div>
      <%= form.label :active, class: 'form-user-status form-check-label d-flex align-items-center justify-content-between mb-2' do %>
        <div class='d-flex flex-column'>
          <span>Actif</span>
          <small>Exerce ses fonctions</small>
        </div>
        <%= form.check_box :active, class: 'form-check-input' %>
        <div class="toggle"></div>
      <% end %>
      <div class="w-100">
        <%= form.label :phone, "Specialité", class: 'form-label' %>
        <%= form.select :skills, options_for_select(Skill.all.pluck(:name, :id), @subcontractor.subcontractor_skills.pluck(:id)),
                                    {},
                                    { multiple:true, data: { controller:"user-skills", user_skills_target: 'select'}} %>
      </div>
    </div>
  </div>
  <div class="d-flex justify-content-end">
    <%= form.button type: 'reset', class: "btn btn-lg btn-outline-secondary btn-cancel btn-text-white mx-2" do %>
      Annuler
    <% end %>
    <%= form.button type:'submit', class: 'btn btn-blue-dark btn-save btn-text-white', data: { form_validate_target: "submit" } do %>
      Suivant
      <%= inline_svg_tag ('icons/direction-straight-right.svg') %>
    <% end %>
  </div>
<% end %>

