<div class="create-subcontractor">
  <div class="settings-container">

    <div class="d-flex align-items-center mb-4">
      <%= link_to settings_subcontractors_path(), class: 'prev-page me-3 d-flex align-items-center justify-content-center' do %>
        <%= inline_svg_tag('icons/arrow-left.svg', class: 'icon-sm') %>
      <% end %>
      <h3 class="mb-0">Modifier sous-traitant</h3>
    </div>
    <!-- Step Indicator -->
    <div class="cover-steps d-flex align-items-center justify-content-center mb-5">
      <div class="step-item active"> 1 </div>
      <div class="step-separation"></div>
      <div class="step-item disabled"> 2 </div>
    </div>

    <%= render 'form', subcontractor: @subcontractor, method: :patch, url: settings_subcontractor_path %>
  </div>
</div>