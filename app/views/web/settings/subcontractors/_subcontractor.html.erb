<div class="subcontractor-list">
  <table class="table ideo-table">
    <thead class='thead-success'>
      <tr>
        <th>Raison sociale</th>
        <th>Gérant</th>
        <th>Email</th>
        <th>Téléphone</th>
        <th>Agents</th>
        <th></th>
      </tr>
    </thead>
    <tbody id="subcontractors-list" class='align-middle'>
      <% subcontractors.each do |subcontractor| %>
        <tr id="subcontractor-<%= subcontractor.id %>">
          <td>
            <div class="social-raison d-flex align-items-center">
              <% if subcontractor.logo.attached? %>
                <%= image_tag subcontractor.logo.variant(resize_to_fit: [50, 50]), alt: "Logo", class: "logo" %>
              <% else %>
                <%= inline_svg_tag ('icons/user-avatar.svg') %>
              <% end %>
              <%= subcontractor.company_name %>
            </div>
          </td>
          <td><%= subcontractor.manager %></td>
          <td><%= subcontractor.email %></td>
          <td><%= subcontractor.phone %></td>
          <td>
            <%= link_to get_agents_settings_subcontractor_path(subcontractor), class:'btn btn-blue btn-see-agent btn-xs btn-text-white',
              data: { controller:'subcontractor-agent', action: 'click->subcontractor-agent#showModal', turbo_frame: 'modal', turbo: 'false'} do %>
              <%= inline_svg_tag ('icons/list.svg') %>
              Voir
            <% end %>
          </td>
          <td>
            <%= link_to edit_settings_subcontractor_path(subcontractor), class:'icon-ideo icon-edit icon-blue icon-20',
              data: { turbo: 'false'} do %>
              <%= inline_svg_tag ('icons/edit.svg') %>
            <% end %>
            <%= link_to settings_subcontractor_path(subcontractor),
                class: 'icon-ideo icon-destroy icon-red icon-16',
                data: { controller:'confirm-modal', action:'click->confirm-modal#confirmDestroy',
                        confirm_modal_target:'itemToBeRemoved',
                        value: "subcontractor-#{subcontractor.id}",
                        turbo_frame: 'modal', turbo: 'false'} do %>
              <%= inline_svg_tag('icons/trash-can.svg') %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
