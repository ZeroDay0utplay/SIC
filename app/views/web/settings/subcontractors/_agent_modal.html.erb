<%= turbo_frame_tag :remote_modal, target: :_top do %>
  <div class="modal fade modal-subcontractor-agent modal-right-side" tabindex="-1" role="dialog" aria-labelledby="agentsModalLabel" aria-hidden="true" data-controller="bs-modal">
    <div class="modal-dialog modal-lg" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="agentsModalLabel">Agents for <%= @subcontractor.company_name %></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <% if @agents.count.positive? %>
            <%= search_form_for @q, url: search_agents_settings_subcontractor_path(@subcontractor), method: :get,
            data: { controller: "search", search_target: 'url' } do |form| %>
              <div class="input-group mb-3">
                <%= form.search_field :first_name_or_last_name_or_email_cont, class: 'form-control',
                    placeholder: 'Rechercher par nom ou email', aria: { label: 'Search by first name or last name' },
                    data: { action: "input->search#search", search_target: "input" } %>
                <button class="btn btn-outline-secondary" type="button" id="button-addon-2">
                  <%= inline_svg_tag('icons/search.svg', aria: { hidden: true }) %>
                </button>
              </div>
            <% end %>

            <%= turbo_frame_tag "cover-agents-subcontractor" do %>
              <%= render 'web/settings/subcontractors/agent_list' %>
            <% end %>

          <% else %>
            <div class="alert alert-warning">
              Aucun agents pour ce sous-traitant.
            </div>
          <% end %>

        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>
<% end %>
