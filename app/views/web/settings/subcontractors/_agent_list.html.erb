<%= turbo_frame_tag "cover-agents-subcontractor" do %>
  <table class="table ideo-table">
    <thead class='thead-success'>
      <tr>
        <th>Nom</th>
        <th>Email</th>
        <th>Téléphone</th>
      </tr>
    </thead>
    <tbody id="agents-list" class='align-middle'>
      <% @agents.each do |agent| %>
        <tr id="agent-<%= agent.id %>">
          <td><%= agent.first_name %> <%= agent.last_name %></td>
          <td><%= agent.email %></td>
          <td><%= agent.phone %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>