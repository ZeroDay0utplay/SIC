<div class="settings-container subcontractor-settings">
  <div class="settings-content">
    <div class="d-flex d-wrap justify-content-between mb-5">
      <h1 class="settings-title mb-0">Liste des Sous-traitans</h1>
      <%= link_to new_settings_subcontractor_path(), class:'btn btn-blue btn-sm btn-add btn-text-white', data: { turbo: false } do %>
        <%= inline_svg_tag('icons/add.svg') %>
        Nouveau sous-traitans
      <% end %>
    </div>

    <%= search_form_for @q, url: settings_subcontractors_path(), method: :get, data: { controller: "search", search_url: settings_subcontractors_path() } do |form| %>

      <div class='d-flex mb-3 align-items-center justify-content-between'>
        <h3 class="title-2 w-50 pe-2"></h3>
        <div class="search-input w-350">
          <%= form.search_field :company_or_manager_cont, class: 'form-control', placeholder: 'Rechercher',
              aria: { label: 'search by company or manager', describedby: 'button-addon-2' },
              data: { action: "input->search#search", search_target: "input" } %>
          <i class="search-icon">
            <%= inline_svg_tag('icons/search.svg') %>
          </i>
        </div>
      </div>

      <%= turbo_frame_tag 'cover-subcontractors-list' do %>
        <%= render 'subcontractor', subcontractors: @subcontractors %>
        <% if @count > 10 %>
          <footer class="d-flex align-items-center justify-content-between p-4">
            <div class="cover-pagination">
              <%= will_paginate @subcontractors, renderer: BootstrapPaginationHelper::BootstrapLinkRenderer %>
            </div>

            <div class='w-25 d-flex align-items-center justify-content-end'>
              <label class='text-gray-dark me-2'>Affichage :</label>
              <%= select_tag :items, options_for_select([10, 20, 30, 40, 50], params[:items]),
                data: { action: "change->search#changeItemsPerPage", search_target: "itemsPerPage" },
                class: "w-25 ml-auto form-select" %>
            </div>
          </footer>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
