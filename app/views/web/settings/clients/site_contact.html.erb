<div class="settings-container d-flex">
  <div class="settings-content">
    <div class="new-client-form-container p-4">
      <div class="d-flex align-items-center mb-4">
        <%= link_to settings_clients_path, class: 'prev-page me-3 d-flex align-items-center justify-content-center' do %>
          <%= inline_svg_tag('icons/arrow-left.svg', class: 'icon-sm') %>
        <% end %>
        <h3 class="mb-0">Nouveau groupe</h3>
      </div>

      <div class="cover-steps d-flex align-items-center justify-content-center">
        <div class="step-item complete">
          <%= inline_svg_tag('icons/checkmark.svg')%>
        </div>
        <div class="step-separation"></div>
        <div class="step-item active"> 2 </div>
      </div>
    </div>
  </div>
</div>
