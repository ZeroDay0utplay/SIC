<%= turbo_frame_tag :remote_modal, target: :_top do %>
  <div class="modal fade modal-lg" id="email_model" tabindex="-1" aria-labelledby="emailModelModalLabel" aria-hidden="true" data-controller="bs-modal">
    <div class="modal-dialog">
      <div class="modal-content">
        <%= form_with(model: [:settings, @email_model], local: true, html: { class: 'form-validate', data: { controller:'form-validate'}}) do |form| %>
          <div class="modal-header">
            <h5 class="modal-title"><%= @email_model.persisted? ? "Modifier model email" : "Nouveau model email" %></h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body" data-controller='modal-email-model'>
            <div class='container me-auto ms-0'>
              <div class='row'>
                <div class="email_model_info_prefix">
                  <p class="prefix">Vous pouvez également utiliser des varibales pour configurer automatiquement votre prefixe :</p>
                  <p>(#lien_public) <span class="prefix">(https://backend.ideogroupe.com/espace_clients/factures/code_lien)</span></p>
                  <p>(#factures) <span class="prefix">(1. FactureNum1 - Prestation - MontantTTC)</span></p>
                </div>
                <div class='col-12 d-flex flex-wrap'>
                  <div class='w-100 pe-2 mb-2'>
                    <%= form.label :subject, 'Objet' %>
                    <%= form.text_field :subject, class: 'form-control', require: true,
                                        data: { action: "blur->form-validate#validate", form_validate_target: "input" } %>
                    <span class="error-message" data-form-validate-target="errorMessage"></span>
                  </div>
                </div>
                <div class='col-12 d-flex flex-wrap'>
                  <div class='w-100 pe-2 mb-2'>
                    <%= form.label :body, "Cors du mail" %>
                    <%= form.rich_text_area :body, class: 'form-control', require: true, data: { controller: 'trix-toolbar', action: "blur->form-validate#validate", form_validate_target: "input"}, id: 'body', placeholder: 'Ecrivez votre text ici ...' %>
                    <span class="error-message" data-form-validate-target="errorMessage"></span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <%= form.button type: 'reset', class: "btn btn-lg btn-outline-secondary btn-cancel btn-text-white", data: { action: 'bs-modal#submitEnd'} do %>
              Annuler
            <% end %>
            <%= form.button type: 'submit', class: "btn btn-lg mx-2 btn-save btn-text-white btn-blue-dark",
                            disabled: true, data: { action: 'bs-modal#submitEnd', form_validate_target:'submit'} do %>
              Enregistrer
              <%= inline_svg_tag('icons/save.svg') %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>