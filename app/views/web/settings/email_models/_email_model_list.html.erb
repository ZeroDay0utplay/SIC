<div class="email-models-list">
  <table class='table ideo-table'>
    <thead class='thead-success'>
    <tr>
      <th>ID</th>
      <th>Sujet</th>
      <th>Objet</th>
      <th></th>
    </tr>
    </thead>
    <tbody id="email-models-list" class='align-middle'>
    <% email_models.each do |email_model| %>
      <tr id="email_model-<%= email_model.id %>">
        <td><%= email_model.id %></td>
        <td><%= email_model.subject %></td>
        <td><%= raw(email_model.body) %></td>
        <td class="align-content-center">
          <%= link_to edit_settings_email_model_path(email_model), class:'icon-ideo icon-edit icon-blue icon-16', data: { controller:'email-models', turbo_frame: 'modal', turbo: 'false'} do %>
            <%= inline_svg_tag ('icons/edit.svg') %>
          <% end %>

          <%= link_to settings_email_model_path(email_model),
                      class: 'icon-ideo icon-destroy icon-red icon-16',
                      data: { controller:'confirm-modal', action:'click->confirm-modal#confirmDestroy',
                              confirm_modal_target:'itemToBeRemoved',
                              value: "email_model-#{email_model.id}",
                              turbo_frame: 'modal', turbo: 'false'} do %>
            <%= inline_svg_tag('icons/trash-can.svg') %>
          <% end %>
        </td>
      </tr>
    <% end %>
    </tbody>
  </table>
</div>


