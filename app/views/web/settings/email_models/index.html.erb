<div class="settings-container d-flex">

  <div class="settings-content" data-controller="search" data-search-url-value="<%= search_settings_email_models_path %>">
    <div class="d-flex d-wrap justify-content-between mb-5">
      <h1 class="settings-title mb-0">modèle de mail</h1>
      <%= link_to new_settings_email_model_path(), class:'btn btn-blue btn-sm btn-add btn-text-white', data: { controller:'email-models', turbo_frame: 'modal', turbo: 'false'} do %>
        <%= inline_svg_tag('icons/add.svg') %>
        Nouveau model email
      <% end %>
    </div>
    <%= search_form_for @q, url: settings_email_models_path(), method: :get, data: { controller: "search", search_url: settings_email_models_path() } do |form| %>
      <div class='d-flex mb-5'>
        <h3 class="title-2 col-sm-12 col-md-6">
          Liste des modèles de mail
        </h3>
        <div class="col-sm-12 col-md-6 d-flex align-items-center justify-content-end">
          <div class="search-input w-350">
            <%= form.search_field :subject_or_body_cont, class: 'form-control', placeholder: 'Rechercher',
                                  aria: { label: 'search by subject or body', describedby: 'button-addon-2' },
                                  data: { action: "input->search#search", search_target: "input" } %>
            <i class="search-icon">
              <%= inline_svg_tag('icons/search.svg') %>
            </i>
          </div>
        </div>
      </div>
      <%= turbo_frame_tag 'cover-email-models-list' do %>
          <%= render 'email_model_list', email_models: @email_models %>

          <% if @count > 10 %>
            <footer class="d-flex align-items-center justify-content-between p-4">
              <div class="cover-pagination">
                <%= will_paginate @email_models, renderer: BootstrapPaginationHelper::BootstrapLinkRenderer %>
              </div>

              <div class='w-25 d-flex align-items-center justify-content-end'>
                <label class='text-gray-dark me-2'>Affichage :</label>
                <%= select_tag :items, options_for_select([10, 20, 30, 40, 50], params[:items]),
                              data: { action: "change->search#changeItemsPerPage", search_target: "itemsPerPage" },
                              class: "w-25 ml-auto form-select" %>
              </div>
            </footer>
          <% end %>
      <% end %>
    <% end %>
  </div>
</div>