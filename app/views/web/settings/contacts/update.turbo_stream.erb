<%= turbo_stream.replace "contact-#{@contact.id}" do %>
	<tr id="contact-<%= @contact.id %>">
    <td><%= @contact.id %></td>
    <td><%= @contact.full_name %></td>
    <td><%= @contact.phone %></td>
    <td><%= @contact.email %></td>
    <td><%= I18n.t("enums.contact_role.#{@contact.role}") %></td>
    <td><%= @contact&.company_name %></td>
    <td><%= @contact.job %></td>
    <td>
      <%= link_to edit_settings_contact_path(@contact), class:'icon-ideo icon-edit icon-blue icon-16', data: { controller:'contacts', turbo_frame: 'modal', turbo: 'false'} do %>
      <%= inline_svg_tag ('icons/edit.svg') %>
      <% end %>

      <%= link_to '#',
        class: 'icon-ideo icon-destroy icon-red icon-16',
        data: { controller: 'confirm-modal', action: 'click->confirm-modal#showModal', url: settings_contact_path(@contact), turbo: 'false' } do %>
      <%= inline_svg_tag('icons/trash-can.svg') %>
      <% end %>
    </td>
	</tr>
<% end %>