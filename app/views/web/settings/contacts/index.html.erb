<div class="settings-container d-flex">

  <div class="settings-content" data-controller="search" data-search-url-value="<%= search_settings_contacts_path %>">
    <div class="d-flex d-wrap justify-content-between mb-4">
      <h1 class="settings-title mb-0">Liste des contacts</h1>
      <%= link_to new_settings_contact_path(), class:'btn btn-blue btn-sm btn-add btn-text-white', data: { controller:'contacts', turbo_frame: 'modal', turbo: 'false'} do %>
        <%= inline_svg_tag('icons/add.svg') %>
        Nouveau contact
      <% end %>
    </div>
    <%= search_form_for @q, url: settings_contacts_path(), method: :get, data: { controller: "search", action: "input->search#search", search_url: settings_contacts_path() } do |form| %>
      <div class='d-flex mb-4'>
        <h3 class="title-2 col-sm-12 col-md-6"></h3>
        <div class="col-sm-12 col-md-6 d-flex align-items-center justify-content-end">
          <div class="search-input w-350">
            <%= form.search_field :combined_search_cont, class: 'form-control', placeholder: 'Rechercher',
              aria: { label: 'search by name or company', describedby: 'button-addon-2' },
              data: { action: "input->search#search", search_target: "input" } %>
            <i class="search-icon">
              <%= inline_svg_tag('icons/search.svg') %>
            </i>
          </div>
        </div>
      </div>
      <%= turbo_frame_tag 'cover-contacts-list' do %>

        <%= render 'contact_list', contacts: @contacts %>

        <% if @count > 10 %>
          <footer class="d-flex align-items-center justify-content-between p-4">
            <div class="cover-pagination">
              <%= will_paginate @contacts, renderer: BootstrapPaginationHelper::BootstrapLinkRenderer %>
            </div>

            <div class='w-25 d-flex align-items-center justify-content-end'>
              <label class='text-gray-dark me-2'>Affichage :</label>
              <%= select_tag :items, options_for_select([10, 20, 30, 40, 50], params[:items]),
                data: { action: "change->search#changeItemsPerPage", search_target: "itemsPerPage" },
                class: "w-25 ml-auto form-select" %>
            </div>
          </footer>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
