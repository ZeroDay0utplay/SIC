<table class='table ideo-table'>
  <thead class='thead-success'>
    <tr>
      <th>ID</th>
      <th>Photo</th>
      <th>Nom</th>
      <th>Compétence</th>
      <th>Poste</th>
      <th>Rôle</th>
      <th>Note</th>
      <th>Status</th>
      <th></th>
    </tr>
  </thead>
  <tbody id='users-list' class='align-middle'>
    <% agents.each do |agent| %>
      <tr id="user-<%= agent.id %>">
        <td><%= agent.id %></td>
        <td class="text-center">
          <% if agent.photo.attached? %>
            <%= image_tag agent.photo.variant(resize_to_fill: [50, 50]), class: 'rounded-circle' %>
          <% else %>
            <%= image_tag 'default_avatar.png', size: "50x50", class: 'rounded-circle' %>
          <% end %>
        </td>
        <td>
          <div class='full-name'><%= agent.full_name %></div>
          <small class='email'><%= agent.email %></small>
        </td>
        <td>

          <% if agent.skills.size > 0 %>
            <div class="skills">
              <%= agent.skills.map(&:name).join(', ') %>
            </div>
          <% end %>

        </td>
        <td><%= agent&.job&.capitalize %></td>
        <td><%= agent&.role.capitalize %></td>
        <td><%= 'Note ??' %></td>
        <td>
          <%= agent.active? ? raw("<span class='user-status enable'> Actif </span>") : raw("<span class='user-status disable'> Inactif </span>") %>
        </td>
        <td class="align-content-center">

          <%= link_to edit_settings_user_path(agent), class:'icon-ideo icon-edit icon-blue icon-20',
                      data: { controller:'edit-mention-legal', turbo_frame: 'modal', turbo: 'false'}  do %>
              <%= inline_svg_tag ('icons/edit.svg') %>
          <% end %>

          <%= link_to settings_user_path(agent),
                class: 'icon-ideo icon-destroy icon-red icon-16',
                data: { controller:'confirm-modal', action:'click->confirm-modal#confirmDestroy',
                        confirm_modal_target:'itemToBeRemoved',
                        value: "user-#{agent.id}",
                        turbo_frame: 'modal', turbo: 'false'} do %>
            <%= inline_svg_tag('icons/trash-can.svg') %>
          <% end %>

          <% if agent.active? %>
            <%= link_to confirm_activate_settings_user_path(agent), class:'icon-ideo icon-red icon-20' ,
                data: { controller: 'confirm-modal', action:'click->confirm-modal#showModal', turbo_frame: 'modal', turbo: 'false'} do %>
              <%= inline_svg_tag('icons/error.svg') %>
            <% end %>
          <% else %>
            <%= link_to confirm_activate_settings_user_path(agent), class:'icon-ideo icon-blue icon-20' ,
                data: { controller: 'confirm-modal', action:'click->confirm-modal#showModal', turbo_frame: 'modal', turbo: 'false'} do %>
              <%= inline_svg_tag('icons/face-activated.svg') %>
            <% end %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
