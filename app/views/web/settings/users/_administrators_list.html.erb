<table class='table ideo-table'>
  <thead class='thead-success'>
    <tr>
      <th>ID</th>
      <th>Photo</th>
      <th>Nom</th>
      <th>Poste</th>
      <th>Rôle</th>
      <th>Note</th>
      <th>Status</th>
      <th></th>
    </tr>
  </thead>
  <tbody id='users-list' class='align-middle'>
    <% administrators.each do |administrator| %>
      <tr id="user-<%= administrator.id %>">
        <td><%= administrator.id %></td>
        <td class="text-center">
          <%= image_tag profile_image(administrator, size: [50, 50]), size: '50x50', class: 'rounded-circle' %>
        </td>
        <td>
          <div class='full-name'><%= administrator.full_name %></div>
          <small class='email'><%= administrator.email %></small>
        </td>
        <td><%= administrator&.job&.capitalize %></td>
        <td><%= administrator&.type.capitalize %></td>
        <td><%= 'Note ??' %></td>
        <td>
          <%= administrator.active? ? raw("<span class='user-status enable'> Actif </span>") : raw("<span class='user-status disable'> Inactif </span>") %>
        </td>
        <td class="align-content-center">
          <%= link_to edit_settings_user_path(administrator), class:'icon-ideo icon-edit icon-blue icon-20', data: { controller:'edit-mention-legal', turbo_frame: 'modal', turbo: 'false'} do %>
            <%= inline_svg_tag ('icons/edit.svg') %>
          <% end %>
          <%= link_to settings_user_path(administrator),
                class: 'icon-ideo icon-destroy icon-red icon-16',
                data: { controller:'confirm-modal', action:'click->confirm-modal#confirmDestroy',
                        confirm_modal_target:'itemToBeRemoved',
                        value: "user-#{administrator.id}",
                        turbo_frame: 'modal', turbo: 'false'} do %>
            <%= inline_svg_tag('icons/trash-can.svg') %>
          <% end %>

          <% if administrator.active? %>
            <%= link_to confirm_activate_settings_user_path(administrator), class:'icon-ideo icon-red icon-20' ,
                data: { controller: 'confirm-modal', action:'click->confirm-modal#showModal', turbo_frame: 'modal', turbo: 'false'} do %>
              <%= inline_svg_tag('icons/error.svg') %>
            <% end %>
          <% else %>
            <%= link_to confirm_activate_settings_user_path(administrator), class:'icon-ideo icon-blue icon-20' ,
                data: { controller: 'confirm-modal', action:'click->confirm-modal#showModal', turbo_frame: 'modal', turbo: 'false'} do %>
              <%= inline_svg_tag('icons/face-activated.svg') %>
            <% end %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
