<div class='settings-container d-flex'>

  <div class='settings-content'>
    <%= render 'web/settings/users/navbar' %>

    <%= search_form_for @q, url: agents_settings_users_path(), method: :get,
        data: { controller: "search", search_url: agents_settings_users_path() } do |form| %>
      <div class='d-flex mb-3 align-items-center justify-content-between'>
        <div class="search-input w-350">
          <%= form.search_field :first_name_or_last_name_or_email_cont, class: 'form-control', placeholder: 'Rechercher',
              aria: { label: 'search by name or company', describedby: 'button-addon-2' },
              data: { action: "input->search#search", search_target: "input" } %>
          <i class="search-icon">
            <%= inline_svg_tag('icons/search.svg') %>
          </i>
        </div>

        <% unless @users.empty? %>
          <div class="filter-agents d-flex mb-3">
            <div class="w-auto">
              <%= form.label :skills, 'Compétences:', class:'form-label text-gray-dark' %>
              <%= form.select :skills, options_for_select(@skills.pluck(:name, :id),
                  selected: params.dig(:q, :skills)), { include_blank: 'Tous' },
                  { class: 'form-select', data: { action: "input->search#search", search_target: "skills" }} %>
            </div>
            <div class="w-auto ms-4">
              <%= form.label :active_eq, 'Statut:', class:'form-label text-gray-dark' %>
              <%= form.select :active_eq,
              options_for_select([['Tous', ''],['Active', 'true'], ['Inactive', 'false']], selected: params.dig(:q, :active_eq)), {},{ class: 'form-select',
              data: { action: "input->search#search", search_target: "status" }} %>
            </div>
          </div>
        <% end %>
      </div>

      <%= turbo_frame_tag 'cover-users-list' do %>
        <%= render 'agents_list', agents: @users %>
        <% if @count > 10 %>
          <footer class="d-flex align-items-center justify-content-between p-4">
            <div class="cover-pagination">
              <%= will_paginate @contacts, renderer: BootstrapPaginationHelper::BootstrapLinkRenderer %>
            </div>

            <div class='w-25 d-flex align-items-center justify-content-end'>
              <label class='text-gray-dark me-2'>Affichage :</label>
              <%= select_tag :items, options_for_select([10, 20, 30, 40, 50], params[:items]),
                  data: { action: "change->search#changeItemsPerPage", search_target: "itemsPerPage" },
                  class: "w-25 ml-auto form-select" %>
            </div>
          </footer>
        <% end %>
      <% end %>


    <% end %>
  </div>
</div>