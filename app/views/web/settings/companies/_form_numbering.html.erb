<div class="edit-numbering mt-5" id="edit-numbering">
  <%= form_for @company, url: numberings_settings_company_path(), method: :patch do |f| %>
    <div class="container me-auto ms-0">
      <div class="row">
        <div class="col-7 d-flex flex-column">
          <div class="mb-2">
            <h2 class="title-2">
              Préfixe
            </h2>
          </div>
          <div class="mb-2">
            <%= f.label :prefix_bill, "Facture", class: "form-label" %>
            <%= f.text_field :prefix_bill, class: "form-control" %>
          </div>
          <div class="mb-2">
            <%= f.label :prefix_quote, "Devis", class: "form-label" %>
            <%= f.text_field :prefix_quote, class: "form-control" %>
          </div>
          <div class="mb-5">
            <%= f.label :prefix_credit, "Avoir", class: "form-label" %>
            <%= f.text_field :prefix_credit, class: "form-control" %>
          </div>
        </div>
        <div class="col-5 mt-5">
          <div class="numbering-description d-flex flex-column">
            <%= link_to '#' do %>
              <%= inline_svg_tag('icons/automatic.svg') %>
              Configuration automatique
            <% end %>
            <span>
              Utiliser des variables pour configurer automatiquement votre prefixe:
              (annee) (2023) (AA) (23) (mois) (01-12) (jour) (01-31)
            </span>
          </div>
        </div>
        <div class="col-12 mt-5">
          <div class="d-flex justify-content-end">
            <%= f.button type: 'reset', class: "btn btn-lg btn-outline-secondary btn-cancel btn-text-white" do %>
              Annuler
            <% end %>
            <%= f.button type: 'submit', class: "btn btn-lg mx-2 btn-save btn-text-white btn-blue-dark" do %>
              Enregistrer
              <%= inline_svg_tag('icons/save.svg') %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
