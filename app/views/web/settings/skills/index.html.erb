<div class="settings-container d-flex" data-controller="search">
  
  <div class="settings-content">
    <h1 class="settings-title mb-4">Compétences</h1>

    <h4 class="mb-4">Nouvelle compétence</h4>
    <%= render 'form', skill: @skill %>

    <%= search_form_for @q, url: settings_skills_path, method: :get, data: { search_url: settings_skills_path } do |form| %>
      <div class="d-flex justify-content-between align-items-center mt-4 mb-4">
        <h4>Liste</h4>

        <div class="search-input w-350">
          <%= form.search_field :combined_search_cont, class: 'form-control',
            placeholder: 'Recherche', aria: { label: 'search by name', describedby: 'button-addon-2' },
            data: { action: "input->search#search", search_target: "input" } %>
          <i class="search-icon">
            <%= inline_svg_tag('icons/search.svg') %>
          </i>
        </div>
      </div>
    <% end %>

    <%= turbo_frame_tag 'cover-skills' do %>
      <div id="cover-skills">
        <table class="table ideo-table">
          <thead class='thead-success'>
            <tr>
              <th>ID</th>
              <th>Compétence</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="skills-list" class='align-middle'>
            <%= turbo_frame_tag "skills-list" do %>
              <%= render @skills %>
            <% end %>
          </tbody>
        </table>

        <footer class="d-flex align-items-center justify-content-between p-4">
          <div class="cover-pagination">
            <%= will_paginate @skills, renderer: BootstrapPaginationHelper::BootstrapLinkRenderer %>
          </div>

          <div class='w-25 d-flex align-items-center justify-content-end'>
            <label class='text-gray-dark me-2'>Affichage :</label>
            <%= select_tag :items, options_for_select([10, 20, 30, 40, 50], params[:items]),
              data: { action: "change->search#changeItemsPerPage", search_target: "itemsPerPage" },
              class: "w-25 ml-auto form-select" %>
          </div>
        </footer>
      </div>
    <% end %>

  </div>
</div>
