<tr data-controller="editable" id="skill-<%= skill.id %>">
  <td><%= skill.id %></td>
  <td>
    <span data-editable-target="name" data-action="click->editable#edit">
      <%= skill.name %>
    </span>

    <div data-editable-target="form" class="d-none">
      <form data-action="submit->editable#update" data-editable-target="id" id="<%= skill.id %>" class='d-flex align-items-start justify-content-start'>
        <div class="w-auto">
          <input type="text" data-editable-target="newName" name="editable[name]" value="<%= skill.name %>" class='form-control w-auto'>
          <div class="d-none" data-editable-target="message">
            <span class='text-danger'>
              Cette compétence existe déjà
            </span>
          </div>
        </div>
        <div class="mx-3">
          <button type="button" class="btn btn-sm btn-outline-secondary btn-cancel btn-text-white " data-action="click->editable#cancel">Cancel</button>
          <button type="submit" class="btn btn-save btn-text-white btn-sm btn-blue-dark">Valider</button>
        </div>
      </form>
    </div>
  </td>

  <td class="text-end">
    <%= link_to 'javascript:void(0)', data: { action: "click->editable#edit" },
    class:'icon-ideo icon-edit icon-blue icon-20' do %>
      <%= inline_svg_tag('icons/edit.svg') %>
    <% end %>
    <%= link_to settings_skill_path(skill),
        class: 'icon-ideo icon-destroy icon-red icon-16',
        data: { controller:'confirm-modal', action:'click->confirm-modal#confirmDestroy',
                confirm_modal_target:'itemToBeRemoved',
                value: "skill-#{skill.id}",
                turbo_frame: 'modal', turbo: 'false'} do %>
      <%= inline_svg_tag('icons/trash-can.svg') %>
    <% end %>
  </td>
</tr>
