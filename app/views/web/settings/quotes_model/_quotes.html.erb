<div data-controller="quotes confirm-modal" class="quote-list">
  <table class="table ideo-table">
    <thead class='thead-success'>
      <tr>
        <th></th>
        <th>ID</th>
        <th>Nom</th>
        <th>Client</th>
        <th>Adresse</th>
        <th>Prestation</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody id="quotes-list" class='align-middle'>
      <% @quotes.each do |quote| %>
        <tr id="quote-<%= quote.id %>">
          <td>
            <input type="checkbox" name="quote_id[]" value="<%= quote.id %>" />
          </td>
          <td>
            <%= quote.id %>
          </td>
          <td><%= quote.template_name %></td>
          <td data-editable-target="name">
            <%= quote.client&.name.upcase %>
          </td>
          <td><%= quote.address&.street %></td>
          <td><%= quote.prestation&.name %></td>
          <td>
            <%= link_to "#", class:"icon-ideo icon-blue icon-20", target: "_blank" do %>
              <%= inline_svg_tag("icons/edit.svg") %>
            <% end %>
            <%= link_to "#", class:"icon-ideo icon-red icon-20" do %>
              <%= inline_svg_tag("icons/trash-can.svg") %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
