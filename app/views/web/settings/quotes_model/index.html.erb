<div class="settings-container">
  <div class="d-flex d-wrap justify-content-between mb-3">
    <h1 class="settings-title mb-0">Devis</h1>
      <%= link_to new_finances_quote_path(), class:'btn btn-blue btn-sm btn-add btn-text-white add-quote' do %>
      <%= inline_svg_tag('icons/add_document.svg') %>
      Nouveau model
    <% end %>
  </div>
  <%= search_form_for @q, url: finances_quotes_path(), method: :get,
      data: { controller: "search", search_url: finances_quotes_path() } do |form| %>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <h4 class='m-0'>Liste des models</h4>
      <div class="search-input w-350">
        <%= form.search_field :combined_search_cont, class: 'form-control', placeholder: 'Rechercher',
            aria: { label: 'search by client_name', describedby: 'button-addon-2' },
            data: { action: "input->search#search", search_target: "input" } %>
        <i class="search-icon">
          <%= inline_svg_tag('icons/search.svg') %>
        </i>
      </div>
    </div>

    <%= turbo_frame_tag 'cover-quotes-list' do %>
      <%= render 'quotes', quotes: @quotes %>
      <% if @count > 10 %>
        <footer class="d-flex align-items-center justify-content-between p-4">
          <div class="cover-pagination">
            <%= will_paginate @quotes, renderer: BootstrapPaginationHelper::BootstrapLinkRenderer %>
          </div>

          <div class='w-25 d-flex align-items-center justify-content-end'>
            <label class='text-gray-dark me-2'>Affichage :</label>
            <%= select_tag :items, options_for_select([10, 20, 30, 40, 50], params[:items]),
              data: { action: "change->search#changeItemsPerPage", search_target: "itemsPerPage" },
              class: "w-25 ml-auto form-select" %>
          </div>
        </footer>
      <% end %>
    <% end %>
  <% end %>
</div>