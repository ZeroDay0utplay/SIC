<table class='table ideo-table'>
  <thead class='thead-success'>
    <tr>
      <th>Nom</th>
      <th>Email</th>
      <th>Agence</th>
      <th></th>
    </tr>
  </thead>
  <tbody id='users-list' class='align-middle'>
    <% @administrators.each do |admin| %>
      <tr>
        <td><%= admin.full_name %></td>
        <td><%= admin.email %></td>
        <td><%= admin.company.social_reason %></td>
        <td>

        </td>
      </tr>
    <% end %>
  </tbody>
</table>
