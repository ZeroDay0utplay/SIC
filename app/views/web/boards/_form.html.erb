<%= turbo_frame_tag :remote_modal, target: :_top do %>
  <div class="modal fade modal-lg" id="board" tabindex="-1" aria-labelledby="boardModalLabel" aria-hidden="true" data-controller="bs-modal">
    <div class="modal-dialog">
      <div class="modal-content">
        <%= form_with(model: [@board], local: true, html: { class: 'form-validate', data: { controller:'form-validate'}}) do |form| %>
          <div class="modal-header">
            <h5 class="modal-title"><%= @board.persisted? ? "Modifier board" : "Nouveau board" %></h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body" data-controller='modal-board'>
            <div class='container me-auto ms-0'>
              <div class='row'>
                <div class='col-12 d-flex flex-wrap'>
                  <div class='w-100 pe-2 mb-2'>
                    <%= form.label :title, 'Titre' %>
                    <%= form.text_field :title, class: 'form-control', require: true,
                                        data: { action: "blur->form-validate#validate", form_validate_target: "input" } %>
                    <span class="error-message" data-form-validate-target="errorMessage"></span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <%= form.button type: 'reset', class: "btn btn-lg btn-outline-secondary btn-cancel btn-text-white", data: { action: 'bs-modal#submitEnd'} do %>
              Annuler
            <% end %>
            <%= form.button type: 'submit', class: "btn btn-lg mx-2 btn-save btn-text-white btn-blue-dark",
                            disabled: true, data: { action: 'bs-modal#submitEnd', form_validate_target:'submit'} do %>
              Enregistrer
              <%= inline_svg_tag('icons/save.svg') %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>