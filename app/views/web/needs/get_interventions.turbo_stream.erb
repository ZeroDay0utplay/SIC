<%= turbo_stream.replace "needs-interventions" do %>
  <%= turbo_frame_tag 'needs-interventions' do %>
    <label class="form-label text-gray-dark">Adresse</label>
    <%= render 'web/shared/interventions_list',
        interventions: @interventions,
        model: @model,
        address:"",
        selected: "" %>
  <% end %>
<% end %>

<%= turbo_stream.replace "needs-primary-contacts" do %>
  <%= turbo_frame_tag 'needs-primary-contacts' do %>
    <%= render 'web/shared/contacts_list', contacts: @contacts, model: @model, type: 'primary', selected: [] %>
  <% end %>
<% end %>

<%= turbo_stream.replace "needs-secondary-contacts" do %>
  <%= turbo_frame_tag 'needs-secondary-contacts' do %>
    <%= render 'web/shared/contacts_list', contacts: @contacts, model: @model, type: 'secondary', selected: [] %>
  <% end %>
<% end %>
