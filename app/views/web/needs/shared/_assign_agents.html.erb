<div class="cover-dispatch">
  <div class="form-group d-flex align-items-center justify-content-start mb-2">
    <div class="form-label text-gray-dark label-left m-0">
      Assigner des agents
      <span class="d-block">
        Ajout manuel sans auto dispatch
      </span>
    </div>
    <%= form.button type: "button", class: "custom-button",
        data: { needs_target: "assignAgent", action: "click->needs#assignAgent" },
        disabled: (@planning.type == "Punctual") do %>
      <%= inline_svg_tag("icons/arrow-right.svg") %>
    <% end %>
    <%= form.hidden_field :agents_list, data: { name: "agentsList" } %>
  </div>
</div>