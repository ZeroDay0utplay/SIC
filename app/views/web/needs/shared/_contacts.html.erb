<div class="col-sm-12">
  <h4 class="title-needs">Contacts</h4>
</div>

<div class="col-sm-12 col-md-6">
  <div class="form-group d-flex flex-column w-100">
    <%= form.label :primary_contacts, "Contacts principales", class: "form-label text-gray-dark" %>
    <%= turbo_frame_tag 'needs-primary-contacts' do %>
      <div class="cover-multi-select" data-controller="multi-select">
        <input type="text" class="multi-select-input" data-multi-select-target="input" disabled readonly value="0 sélectionné(s)" />
      </div>
    <% end %>
  </div>
</div>

<div class="col-sm-12 col-md-6">
  <div class="form-group d-flex flex-column w-100">
    <%= form.label :secondary_contacts, "Contacts secondaires", class: "form-label text-gray-dark" %>
    <%= turbo_frame_tag 'needs-secondary-contacts' do %>
      <div class="cover-multi-select" data-controller="multi-select">
        <input type="text" class="multi-select-input" data-multi-select-target="input" disabled readonly value="0 sélectionné(s)" />
      </div>
    <% end %>
  </div>
</div>