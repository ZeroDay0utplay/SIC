<%= turbo_frame_tag :remote_modal, target: :_top do %>
  <div class="modal fade modal-need-agents w-900 modal-right-side" tabindex="-1" aria-labelledby="agentsModalLabel" data-controller="bs-modal needs-agents" style="display: none;">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="agentsModalLabel">Liste des agents</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">

          <table class="table ideo-table">
            <thead class='thead-success'>
              <tr>
                <th></th>
                <th>Nom</th>
                <th>Prénom</th>
                <th>Téléphone</th>
                <th>Email</th>
                <th>Compétences</th>
              </tr>
            </thead>
            <tbody id="agents-list" class='align-middle'>
              <% @agents.each do |agent| %>
                <tr id="agent-<%= agent.id %>">
                  <td>
                    <input type="checkbox" data-needs-agents-target="agentID" data-action="click->needs-agents#toggleAgentID" value="<%= agent.id %>">
                  </td>
                  <td><%= agent.first_name %></td>
                  <td><%= agent.last_name %></td>
                  <td><%= agent.phone %></td>
                  <td><%= agent.email %></td>
                  <td>
                    <div class="skills-cover d-flex flex-wrap">
                      <%= agent.set_skills.html_safe %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>

        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-sm btn-outline-secondary btn-cancel btn-text-white mx-2" data-action="click->needs-agents#clearAgentsList click->bs-modal#removeModal" data-action="">Annuler</button>
          <button type="button" class="btn btn-sm mx-2 btn-save btn-text-white btn-blue-dark" data-action="click->bs-modal#removeModal">
            Enregistrer
            <%= inline_svg_tag("icons/save.svg") %>
          </button>
        </div>
      </div>
    </div>
  </div>
<% end %>
